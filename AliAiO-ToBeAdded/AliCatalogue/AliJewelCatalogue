    tmpFile.Close();
    }


function GetInventoryFromFile()
    { 
    var tmpFilePath = Orion.CurrentScriptDirPath() + '/' + inventoryFileName;
    var tmpFile = Orion.NewFile();
    if(!tmpFile.Open(tmpFilePath))
        return Orion.CharPrint(self,1159,'Something went wrong trying to read or create file: ' + inventoryFileName);
    var fileRead = tmpFile.ReadAll();
    if(!fileRead)
        fileRead = "{}";
    var fileSani = fileRead.replace(/\r?\n/g, "");
    var fileObj = JSON.parse(fileSani) || {};
    tmpFile.Close();
    return fileObj
    }


    
