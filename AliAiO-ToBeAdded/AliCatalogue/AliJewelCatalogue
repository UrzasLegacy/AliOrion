var inventoryFileName = "AliSpreadsheetInventory.JSON"

function StartJewelryCatalogue()
    {
    var items = AggregateNearbyJewelry()
    var currentInventory = GetInventoryFromFile()

    var newItems = items.filter(function(itemArray)
        {
        var item = itemArray[0]
        return !currentInventory[item.Serial()]
        })
    newItems.forEach(function(item)
        {
        var item = itemArray[0]
        var parentContainer = itemArray[1]
        var currentCoords = itemArray[2]
        currentInventory[item.Serial()] = [parseModsObjForDatabase(item), parentContainer, currentCoords]
        })

    OverwriteInventoryFile(currentInventory)
    }


function AggregateNearbyJewelry()
    {
    var parentContainer
    var currentCoords
    var items = Orion.FindTypeEx("0x1F06|0x1F09|0x1086|0x108A",any,parentContainer).map(function(item)
        {
        return [item,parentContainer,currentCoords]
        });
    return items
    }


function parseModsObjForDatabase(jewelryObj)
    {
    var jewelryProperties = jewelryObj.Properties()
    var jewelryGraphic = jewelryObj.Graphic()
    var itemType
    if(Orion.Contains('0x1086|0x108A', jewelryGraphic))
        itemType = "Bracelet"
    else if(Orion.Contains('0x1F06|0x1F09', jewelryGraphic))
        itemType = "Ring"
    if(!itemType)
        return {}

    var targetMods = 
        {
        //good mods
        Magery:true,MaceFighting:true,Fencing:true,Swordsmanship:true,AnimalTaming:true,AnimalLore:true,SpiritSpeak:true,Tactics:true,
        Focus:true,Parrying:true,Stealth:true,Anatomy:true,Bushido:true,EvaluateIntelligence:true,Mysticism:true,Wrestling:true,
        Necromancy:true,Archery:true,Chivalry:true,Healing:true,Ninjitsu:true,Throwing:true,ResistingSpells:true,ManaIncrease:true,
        StaminaIncrease:true,StrengthBonus:true,DexterityBonus:true,IntelligenceBonus:true,ManaRegeneration:true,EnhancePotions:true,
        HitChanceIncrease:true,DefenseChanceIncrease:true,SwingSpeedIncrease:true,DamageIncrease:true,SpellDamageIncrease:true,
        FasterCastRecovery:true,FasterCasting:true,LowerManaCost:true,LowerReagentCost:true,Musicianship:true,Discordance:true,
        //bad mods
        NightSight:true,Luck:true,PoisonResist:true,PhysicalResist:true,FireResist:true,EnergyResist:true,ColdResist:true,
        Provocation:true,Meditation:true,Veterinary:true,Stealing:true,Peacemaking:true
        }
    var skillMods = 
        {
        Magery:true,Wrestling:true,Focus:true,EvaluateIntelligence:true,Chivalry:true,
        Mysticism:true,MaceFighting:true,Fencing:true,Swordsmanship:true,Stealth:true,
        Parrying:true,Bushido:true,Ninjitsu:true,ResistingSpells:true,Anatomy:true,
        Tactics:true,Necromancy:true,AnimalTaming:true,AnimalLore:true,SpiritSpeak:true,
        Throwing:true,Healing:true, Archery:true,Meditation:true,Musicianship:true,Discordance:true,
        }
    var modCount = 0
    var skillCount = 0
    var lines = jewelryProperties.split("\n");
    var modsObj = {"itemType": itemType};
    lines.forEach(function(line)
        {
        var modMatch = line.match(/([a-zA-Z\s]+):?\s*\+?\s*([0-9]+)?/);
        if(modMatch)
            {
            var modName = modMatch[1].replace(/\s/g, '');
            if(targetMods[modName])
                {
                modCount++
                var modValue = parseInt(modMatch[2]) || 1;
                modsObj[modName] = modValue;
                if(skillMods[modName])
                    skillCount++
                }
            }
        });
    var isClean = jewelryProperties.indexOf('Antique') === -1 && jewelryProperties.indexOf('Imbued') === -1;
    var highScoreData = CalculateHighScore(jewelryProperties)
    modsObj["ModCount"] = modCount
    modsObj["SkillCount"] = skillCount
    modsObj["IsClean"] = isClean
    modsObj["HighScore"] = highScoreData[1]
    modsObj["HighTemplate"] = highScoreData[0]
    return modsObj; //[{goodMods},totalModsInt]
    }






