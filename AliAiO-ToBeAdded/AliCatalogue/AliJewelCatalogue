function NeedleInAHayStack()
    { //v1
    // This function finds all containers on the same floor as the player and systematically searches through
    // all of them to find any object with the textSearch string in its tooltip. 
    // Will take the item into your backpack, highlight the parent container it was found in, and continue searching.
    var textSearch = 'Retouch';
    var containers = Orion.FindTypeEx(any,any,ground,'item',24).filter(function(item) 
        {
        var itemZ = item.Z();
        var itemProps = item.Properties();
        var playerZ = Player.Z();
        var zCheck = itemZ >= playerZ && itemZ <= playerZ + 19
        var containerCheck = Orion.Contains(itemProps,'Contents: ');
        var emptyCheck = Orion.Contains(itemProps,'Contents: 0/');
        return zCheck && containerCheck && !emptyCheck;
        }).sort(function(a,b) //sort by nearest
            {
            return a.Distance() - b.Distance();
            });
    for(var i=0;i<containers.length;i++) //loop through em
        {
        var containerObj = containers[i];
        var containerSerial = containerObj.Serial();
        var containerX = containerObj.X();
        var containerY = containerObj.Y();
        var containerZ = containerObj.Z();
        VerifyWalkTo(containerX,containerY,containerZ,1);
        var subContainers = GetAllSubContainers(containerSerial,true);
        for(var j=0;j<subContainers.length;j++)
            {
            var subContainerSerial = subContainers[j];
            var searchItem = Orion.FindTypeEx(any,any,subContainerSerial).filter(function(item)
                {
                return Orion.Contains(item.Properties(),textSearch)
                });
            while(searchItem[0])
                {
                Orion.CharPrint(containerSerial,1159,textSearch + ' Found!')
				Orion.TestItemColor(containerSerial, 1152);
                Orion.MoveItem(searchItem[0].Serial());
                Orion.Wait(1300);
                searchItem = Orion.FindTypeEx(any,any,subContainerSerial).filter(function(item)
                    {
                    return Orion.Contains(item.Properties(),textSearch)
                    });
                }
            }
        }
    }

var subContainersArr = [];
function GetAllSubContainers(containerSerial,ignoreEmpties)
    {
    if(!VerifyOpenContainer(containerSerial))
        return;
    subContainersArr.push(containerSerial);
    var subContainers = Orion.FindTypeEx(any,any,containerSerial).filter(function(item)
        {
        var itemProps = item.Properties();
        var containerCheck = Orion.Contains(itemProps,'Contents: ');
        if(ignoreEmpties)
            return containerCheck && !Orion.Contains(itemProps,'Contents: 0/');;
        return containerCheck;
        });
    for(var i=0;i<subContainers.length;i++)
        {
        var subContainer = subContainers[i];
        GetAllSubContainers(subContainer.Serial(),ignoreEmpties);
        }
    Orion.CloseGump('container',containerSerial);
    return subContainersArr;
    }
    
function VerifyOpenContainer(containerSerial,delay)
    {
    var startTime = Orion.Now();
    var endTime = startTime + (delay || 5000);
    while(!Orion.GumpExists('container',containerSerial))
        {
        if(Orion.Now() > endTime)
            return false;
        Orion.UseObject(containerSerial);
        Orion.Wait(1000);
        }
    return true;
    }

function AliReadAndOverwriteFile(inputString,fileNameString)
    { //"[1,2,3]","ReadAndOverwriteTest.txt"
    var tmpFilePath = Orion.CurrentScriptDirPath() + '/' + fileNameString;
    var tmpFile = Orion.NewFile();
    if(!tmpFile.Open(tmpFilePath))
        return Orion.CharPrint(self,1159,'Something went wrong trying to read or create file: ' + fileNameString);
    var fileRead = tmpFile.ReadAll();
    if(!fileRead)
        fileRead = "[]";
    Orion.Print("Appending " + inputString + ' To File: ' + tmpFilePath);
    var fileArr = JSON.parse(fileRead) || [];
    var inputArr = JSON.parse(inputString) || [];
    var outputArr = [];
    for(var i=0;i<inputArr.length;i++)
        {
        var inputEle = +inputArr[i];
        var fileEle = +fileArr[i];
        var sum = inputEle + fileEle
        Orion.Print(inputEle + '+' + fileEle + '=' + sum)
        outputArr[i] = sum;
        }
    var outputStr = JSON.stringify(outputArr)
    tmpFile.Remove();
    tmpFile.Open(tmpFilePath)
    tmpFile.Write(outputStr);
    tmpFile.Close();
    }