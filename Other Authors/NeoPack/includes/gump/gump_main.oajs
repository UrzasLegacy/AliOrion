function GumpMain_ResetDefault(arg) {
	switch (arg) {
		case "all":
			Orion.SetGlobal("MainGump_resetDefault", "true");
			break;
		case "position":
			Orion.SetGlobal("MainGump_resetPosition", "true");
			break;
		default:
			return false;
	}
	MainGump();
}

function MainGumpResponse(unused) {
	var JSON_fName = mainGumpJSON;
	var code = parseInt(CustomGumpResponse.ReturnCode());
	var serial = parseInt(CustomGumpResponse.Serial());
	Debug("[MainGumpResponse][Info] Return code / serial : " + code + " / " + serial);
	var gumpObj = JSON_import_handler(JSON_fName, false);
	if (gumpObj && "main" in gumpObj && serial == gumpObj.main.serial) {
		var returnKey = ResposeSerialFinder(code, gumpObj);
		if (!returnKey) {
			Debug("[MainGumpResponse][Error] Getting invalid code / serial for this gump: " + code + " / " + serial);
			return false;
		}
		//Handling Character Saving
		if ("action" in gumpObj[returnKey] && Orion.Contains(gumpObj[returnKey].value, "ModifyCharacter")) {
			Orion.SetGlobal("doUpdateCharacter", gumpObj[returnKey].value);
			gumpObj[returnKey].value = "refresh";
		}
		if ("action" in gumpObj[returnKey]) {
			GumpResponseAction(serial, JSON_fName, gumpObj[returnKey].action, "MainGump", gumpObj[returnKey].value);
		} else {
			Debug("[MainGumpResponse][Error] This response has no action.");
		}
	} else {
		if (gumpObj && "main" in gumpObj) {
			Debug("[MainGumpResponse][Error] Getting invalid code / serial / main.serial for this gump: " + code + " / " + serial + "/" + main.serial);
		} else {
			Debug("[MainGumpResponse][Error] Main window not found, getting invalid code / serial for this gump: " + code + " / " + serial);
		}
	}
}

function FuncLibrary_Update(gumpObj) {
	var selectedOne = Orion.GetGlobal("funcLib_Selected") == "" ? false : Orion.GetGlobal("funcLib_Selected");
	var theFilter = gumpObj.FunctionFilter_Dropdown.droplist[gumpObj.FunctionFilter_Dropdown.value][0];
	Debug("[FuncLibrary_Update][Info] Selected Function Library filter: " + theFilter + ", filtering " + gumpObj.funcLib.value.length + " functions.");
	//Applying filter to function list
	for (var i = 0; i < gumpObj.funcLib.value.length; i++) {
		if (theFilter == "All") {
			gumpObj[gumpObj.funcLib.value[i]].visible = true;
		} else {
			var theFunc = gumpObj[gumpObj.funcLib.value[i]].theFunc;
			Debug("[FuncLibrary_Update][Info] Evaluating: " + gumpObj.funcLib.value[i] + " which has tags: " + theFunc.tags);
			if (theFunc.tags.indexOf(theFilter) != -1) {
				gumpObj[gumpObj.funcLib.value[i]].visible = true;
			} else {
				gumpObj[gumpObj.funcLib.value[i]].visible = false;
				Debug("[FuncLibrary_Update][Info] Hiding: " + gumpObj.funcLib.value[i]);
			}
		}
	}
	//Adjusting the Y position of the remaining active functions
	var tempY = 5;
	for (var i = 0; i < gumpObj.funcLib.value.length; i++) {
		if (gumpObj[gumpObj.funcLib.value[i]].visible == true) {
			gumpObj[gumpObj.funcLib.value[i]].y = tempY;
			tempY += 30;
		}
	}
	//Updating the main window data
	Debug("[FuncLibrary_Update][Info] Selected function: " + selectedOne);
	if (selectedOne == false) {
		gumpObj["title_function_title_value"].text = "N/A";
		gumpObj["title_function_location_value"].text = "N/A";
		gumpObj["title_function_tags_value"].text = "N/A";
		gumpObj["function_description_value"].text = "N/A";
	} else {
		Debug("[FuncLibrary_Update][Info] Swapping Info to: " + selectedOne);
		if (selectedOne in gumpObj && "theFunc" in gumpObj[selectedOne]) {
			selectedOne = gumpObj[selectedOne].theFunc;
			gumpObj["title_function_title_value"].text = selectedOne.name;
			gumpObj["title_function_location_value"].text = selectedOne.location;
			gumpObj["title_function_tags_value"].text = selectedOne.tags;
			Debug("[FuncLibrary_Update][Trace] Description String Length: " + String(selectedOne.description).length);
			gumpObj["function_description_value"].text = WordWrapString(selectedOne.description, 60);
		}
	}
	return gumpObj;
}

function WordWrapString(theString, width) {
	theString = String(theString);
	var currPos = 0;
	var iterations = parseInt(theString.length / width);
	Debug("[WordWrapString][Info] Number of iterations needed: " + iterations);
	if (theString.length > 60) {
		for (var i = 1; i <= iterations; i++) {
			currPos += width;
			while (theString[currPos] != " ") {
				currPos--;
			}
			Debug("[WordWrapString][Trace] Adding line break at: " + currPos);
			theString = theString.slice(0, currPos) + "\n" + theString.slice(currPos + 1);
			Debug("[WordWrapString][Trace] Newly formatted string: " + theString);
		}

		return theString;
	} else {
		return theString;
	}
}

function WordWrapString_old(theString, width) {
	theString = String(theString);
	var currPos = 0;
	var iterations = parseInt(theString.length / width);
	Debug("[WordWrapString][Info] Number of iterations needed: " + iterations);
	if (theString.length > 60) {
		for (var i = 1; i <= iterations; i++) {
			currPos += width;
			while (theString[currPos] != " ") {
				currPos--;
			}
			Debug("[WordWrapString][Trace] Adding line break at: " + currPos);
			theString = theString.slice(0, currPos) + "\n" + theString.slice(currPos + 1);
			Debug("[WordWrapString][Trace] Newly formatted string: " + theString);
		}

		return theString;
	} else {
		return theString;
	}
}

function GumpValidation_MainGump(gumpObj) {
	Orion.SetGlobal("characterLib_Selected", "");
	Orion.SetGlobal("funcLib_Selected", "");
	Object.keys(gumpObj).forEach(function (key) {
		if ("globalVal" in gumpObj[key] && "globalAsReg" in gumpObj[key] && gumpObj[key].globalAsReg == true && gumpObj[key].visible == true) {
			Orion.RegWrite(Player.Serial() + "/" + gumpObj[key].globalVal, gumpObj[key].value);
		} else if ("globalVal" in gumpObj[key] && gumpObj[key].visible == true) {
			Debug("[GumpValidation_MainGump][Trace] Setting global (" + gumpObj[key].globalVal + "), of key (" + key + ") with the following value: " + gumpObj[key].value);
			Orion.SetGlobal(gumpObj[key].globalVal, gumpObj[key].value);
			if (gumpObj[key].type == "combobox" && "droplist" in gumpObj[key] && "value" in gumpObj[key]) {
				Orion.SetGlobal(gumpObj[key].globalVal, gumpObj[key].droplist[gumpObj[key].value][0]);
			}
		}
		if ("runFunction" in gumpObj[key] && gumpObj[key].visible == true) {
			Debug("[GumpValidation_MainGump][Trace] Executing the function: " + gumpObj[key].runFunction);
			Orion.Exec(gumpObj[key].runFunction, true);
		}
		Debug("[GumpValidation_MainGump][Trace] Search String key: " + key + " Value: " + gumpObj[key].value);
		if (Orion.Contains(key, "functionLib", true) && gumpObj[key].value == true) {
			Orion.SetGlobal("funcLib_Selected", key);
		}
		if (Orion.Contains(key, "characterLib", true) && gumpObj[key].value == true) {
			Orion.SetGlobal("characterLib_Selected", key);
		}
	});
	if (Orion.GetGlobal("doUpdateCharacter") != "") {
		gumpObj = CharacterLibrary_UpdateCharacter(gumpObj, Orion.GetGlobal("doUpdateCharacter"));
		Orion.SetGlobal("doUpdateCharacter", "");
	}
	return gumpObj;
}

function ItemColorObject(name, color) {
	var test = {};
	test.name = name;
	test.color = color;
	test.defaultIndex = false;
	return test;
}

function ItemColorDropdown(anObj) {
	var dropArray = [];
	Object.keys(anObj).forEach(function (key2) {
		var tempArray = [];
		tempArray = [key2, anObj[key2].name];
		dropArray.push(tempArray);
	});
	return dropArray;
}
