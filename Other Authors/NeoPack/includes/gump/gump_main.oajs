function init_MainGump() {
	Orion.Exec("MainGump", true);
	Orion.Exec("GumpLaunchButton", true);
	if (false && trainingActive) {
		Orion.OpenContainer("backpack");
		Orion.Wait(1200);
		Orion.SetGlobal("skillGumpfirst", "false");
		Orion.Exec("skillGump", true);
	}
}

var eventColors = {};
eventColors["other"] = ItemColorObject("Other", "other");
eventColors["other"].defaultIndex = true;
eventColors["0x0ACC"] = ItemColorObject("Shogun (Tokuno)", "0x0ACC");
eventColors["0x0AC6"] = ItemColorObject("Wildfire (Fire)", "0x0AC6");
eventColors["0x0AC1"] = ItemColorObject("Demonic (Hythloth)", "0x0AC1");
eventColors["0x0AC3"] = ItemColorObject("Eggs (Destard)", "0x0AC3");
eventColors["0x0A8E"] = ItemColorObject("Lichian (Deciet)", "0x0A8E");

var mainGumpJSON = "Main_gump_" + Player.Serial();

function MainGump() {
	Orion.SetTimer("launchTime", 0);
	Debug("[MainGump][Log] Launching the new main gump!");

	var JSON_fName = mainGumpJSON;
	//Loading default settings for gump
	var gumpObj = MainGump_Setup();
	//Reset all default settings
	var resetDefault = Orion.GetGlobal("MainGump_resetDefault") == "true" ? true : false;
	//resetDefault = true;
	if (!resetDefault) {
		Debug("[MainGump][Info] Importing JSON: " + JSON_fName);
		gumpObj = JSON_import_handler(JSON_fName, gumpObj);
	} else {
		Orion.SetGlobal("MainGump_resetDefault", "false");
		Orion.Print("Resetting all settings to default!");
		gumpObj.version = {};
		gumpObj.version.global = true;
		gumpObj.version.currentVersion = currentVersion;
	}
	//Reset Gump Poisition
	if (Orion.GetGlobal("MainGump_resetPosition") == "true") {
		gumpObj.main.x = 50;
		gumpObj.main.y = 50;
		Orion.SetGlobal("MainGump_resetPosition", "false");
	}
	//Resetting Gump if Version has changed
	if (!("version" in gumpObj) || ("version" in gumpObj && currentVersion > gumpObj.version.currentVersion)) {
		Orion.SetGlobal("MainGump_resetDefault", "true");
		JSON_export(JSON_fName, gumpObj);
		Orion.Exec("MainGump", true);
		return false;
	}
	//Proceeding with validating and building the gump
	gump = GumpValidation_MainGump(gumpObj);
	//Update the Function Library Displays
	gumpObj = FuncLibrary_Update(gumpObj);
	//Update the Character Library Display and JSON
	if (Orion.GetGlobal("doCharRebuild") == "true") {
		gumpObj = CharacterLibrary_Rebuild(gumpObj);
		Orion.SetGlobal("doCharRebuild", "false");
	}
	gumpObj = CharacterLibrary_UpdateGump(gumpObj);
	//Hiding the gump if logging in or relogging
	Debug(
		"[MainGump][Info] Deciding to hide MainGump (Global: " +
			Orion.GetGlobal("MainGump_opened_" + gumpObj.main.serial) +
			", InJournal: " +
			Orion.InJournal("Reconnecting", "sys", "0", "any", Orion.Now() - 3000, Orion.Now()) +
			")."
	);
	if (Orion.GetGlobal("MainGump_opened_" + gumpObj.main.serial) == "true" && Orion.InJournal("Reconnecting", "sys", "0", "any", Orion.Now() - 3000, Orion.Now()) == null) {
		GenerateGump_Fast(gumpObj);
	}
	Orion.SetGlobal("MainGump_opened_" + gumpObj.main.serial, "true");
	Debug("[MainGump][Trace] JSON export returned: " + JSON_export(JSON_fName, gumpObj));
	Debug("[MainGump][Log] Launch Time: " + Orion.Timer("launchTime") / 1000 + " seconds");
	//Auto start additional functions
	//Orion.Exec("AutoEverything", true);
}

function MainGump_ResetDefault() {
	Orion.SetGlobal("MainGump_resetDefault", "true");
}

