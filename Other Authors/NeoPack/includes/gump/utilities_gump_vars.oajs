//Structure for gump objects
function GumpObj(type, posX, posY) {
	var test = {};
	test.serial = null;
	test.posX = posX;
	test.posY = posY;
	test.text = null;
	test.width = null;
	test.height = null;
	test.butStatic = null;
	test.butHover = null;
	test.butClick = null;
	test.array = null;
	return test;
}

function GumpObject(name, serial, type, x, y, autoPosition, autoRow) {
	var tempObj = {};

	tempObj.name = name; //A name of the
	tempObj.serial = serial;
	tempObj.type = type; //Type: Combo,button,checkbox,
	tempObj.text = null; //If the object displays text, value here.
	tempObj.value = null; //This saves the state/value of the object.
	tempObj.visible = true; //Attach to a column name or true to show always, false hide default.
	tempObj.parent = false; //Flagging whether this object has a parent window/gump or not.
	tempObj.color = color.black; //Setting default to match default backgrounds
	tempObj.columnParent = false;
	tempObj.pageVisChange = false; //Used to track if page visibility is what made it not visible.
	tempObj.parentPage = 0;
	tempObj.autoPosition = autoPosition; //Variable to set if you want the constructor to handle row and x position.
	tempObj.filtered = false; //A flag to determine if this item has been filtered.
	//tempObj.defaultVal = false;
	tempObj.x = x;
	tempObj.y = y;
	if (tempObj.autoPosition == true) {
		tempObj.rowHeight = 35;
		tempObj.autoRow = autoRow;
		tempObj.xOffset = 0;
		tempObj.json = null;
	}
	//Defaults for various objects
	switch (type) {
		case "column":
			tempObj.columnParent = true;
			break;
		case "html":
			tempObj.hasbackground = 0;
			tempObj.hasScrollbar = true;
			break;
		case "htmltext":
			tempObj.height = 12;
			break;
		case "page":
			tempObj.pageVis = false;
			break;
		case "checkbox":
			tempObj.graphic = "default";
			tempObj.text = "";
			tempObj.txtColor = color.sliderwhite;
			break;
		case "main" || "background":
			tempObj.background = "default";
			tempObj.noclose = false;
			tempObj.nomove = false;
			break;
		case "combobox":
			tempObj.defselection = -1;
			tempObj.value = -1;
			tempObj.droplength = 5;
			tempObj.background = "background_generic_grey";
			tempObj.width = 100;
			tempObj.droplist = false;
			break;
		case "button":
			tempObj.butAction = 0; //Defualt 0 (to page), 1 = gump action (returns button serial)
			tempObj.butToPage = -1; //if 0 above, which page to swtich to.
			tempObj.butText = false;
			tempObj.butTextOffX = 0;
			tempObj.butTextOffY = 0;
			tempObj.dynamic = "hello2";
			break;
		case "plusminus":
			tempObj.graphic = "std_plus_minus";
			tempObj.background = "background_generic_grey";
			tempObj.value = 0;
			tempObj.valMin = 0;
			tempObj.valMax = 100;
			tempObj.showText = 1;
			tempObj.showPos = "right";
			break;
		case "text":
			tempObj.textOffset = 0;
			tempObj.color = color.white;
			break;
		case "textbox":
			tempObj.width = 50;
			tempObj.height = 25;
			tempObj.value = "";
			tempObj.background = "background_generic_grey";
			break;
		case "slider":
			tempObj.graphic = "slider_std_knob";
			tempObj.background = "slider_std_background";
			tempObj.value = 0;
			tempObj.valMin = 0;
			tempObj.valMax = 100;
			tempObj.showText = 1;
			tempObj.showPos = "right";
			break;
		default:
			break;
	}

	return tempObj;
}

function GumpGraphicObject(name, type, graphic) {
	var tempObj = {};

	tempObj.name = name;
	tempObj.type = type;
	tempObj.graphic = graphic;

	if (type == "button") {
		tempObj.butText = false;
		tempObj.butTextOffX = 0;
		tempObj.butTextOffY = 0;
		tempObj.butWidth = 100;
		tempObj.butHeight = 20;
	}

	return tempObj;
}

