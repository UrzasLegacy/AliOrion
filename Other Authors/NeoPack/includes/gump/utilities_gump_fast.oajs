//Function that handles the creation of the gump itself using the gumpDictionary passed into it
function GenerateGump_Fast(gumpDictionary) {
	Debug("[GenerateGump][Trace] Starting function.");
	if (gumpDictionary && "main" in gumpDictionary) {
		if (gumpDictionary["main"].background == "default") {
			gumpDictionary["main"].background = gumpGraphic.background_greygold.graphic;
		} else if (gumpDictionary["main"].background in gumpGraphic) {
			gumpDictionary["main"].background = gumpGraphic[gumpDictionary["main"].background].graphic;
		}
		var gump = Orion.CreateCustomGump(gumpDictionary["main"].serial);
		//gump.SetPage(0);
		var key = "main";
		gump.SetNoClose(gumpDictionary["main"].noclose);
		gump.SetNoMove(gumpDictionary["main"].nomove);
		gump.Clear();
		if (gumpDictionary["main"].background != false) {
			gump.AddResizepic(0, 0, gumpDictionary["main"].background, gumpDictionary["main"].width, gumpDictionary["main"].height);
		}
		gump.SetCallback(gumpDictionary["main"].callback);
		gump.SetX(gumpDictionary["main"].x);
		gump.SetY(gumpDictionary["main"].y);
	} else {
		Debug("[GenerateGump][Error] No 'main' object in gump object dictionary.");
		return false;
	}
	var pageArray = PageObject(gumpDictionary);
	delete gumpDictionary.PosVariable;
	gump = GumpConstructor_Fast(gump, gumpDictionary, pageArray);
	gump.Select("gump");
	gump.Update();

	return true;
}

function GumpConstructor_Fast(gump, gumpDictionary, pageArray) {
	Object.keys(pageArray).forEach(function (page) {
		for (var i = 0; i < pageArray[page].array.length; i++) {
			if (gumpDictionary[pageArray[page].array[i]].type != "html") {
				Debug("[GumpConstructor_Fast][Trace] Create Gump Object (page): " + pageArray[page].array[i] + "(" + page + ")");
				gump = GumpSegmentCreator(gump, gumpDictionary, pageArray[page].array[i]);
			}
			if ("html" in pageArray[page] && i == pageArray[page].array.length - 1) {
				Object.keys(pageArray[page].html).forEach(function (htmlWindow) {
					if (gumpDictionary[htmlWindow].parentPage == page) {
						gump.Select("gump");
						Debug("[GumpConstructor_Fast][Trace] Creating HTML Window: " + pageArray[page].html[htmlWindow][0]);
						gump = GumpSegmentCreator(gump, gumpDictionary, pageArray[page].html[htmlWindow][0]);
						gump.Select("htmlgump", gumpDictionary[htmlWindow].serial);
						Debug("[GumpConstructor_Fast][Trace] HTML Window found (" + htmlWindow + ", " + +gumpDictionary[htmlWindow].serial + "), create associated objects (" + pageArray[page].html[htmlWindow].length + ").");
						for (var j = 1; j < pageArray[page].html[htmlWindow].length; j++) {
							Debug("[GumpConstructor_Fast][Trace] HTML Page / Object: " + page + " / " + pageArray[page].html[htmlWindow][j]);
							gump = GumpSegmentCreator(gump, gumpDictionary, pageArray[page].html[htmlWindow][j]);
						}
					}
				});
				gump.Select("gump");
			}
		}
	});
	return gump;
}

function PageObject(gumpDictionary) {
	var returnObj = {};
	returnObj = {};
	returnObj[0] = {};
	returnObj[0].array = [];
	//building out all the pages and HTML windows
	Object.keys(gumpDictionary).forEach(function (key) {
		if (gumpDictionary[key] != null && !("global" in gumpDictionary[key] && gumpDictionary[key].global)) {
			//Using switch expression to skip if its a child object
			var switchExpression = gumpDictionary[key].type;
			switch (switchExpression) {
				case "html":
					if (!("html" in returnObj[gumpDictionary[key].parentPage])) {
						//returnObj[gumpDictionary[key].parentPage] = {};
						returnObj[gumpDictionary[key].parentPage].html = {};
						returnObj[gumpDictionary[key].parentPage].html[key] = [];
						returnObj[gumpDictionary[key].parentPage].html[key].push(key);
						Debug("[PageObject][Info] Creating the HTML object on page " + gumpDictionary[key].parentPage + " and adding the html window: " + key);
					} else {
						returnObj[gumpDictionary[key].parentPage].html[key] = [];
						returnObj[gumpDictionary[key].parentPage].html[key].push(key);
						Debug("[PageObject][Info] Adding HTML window to page " + gumpDictionary[key].parentPage + ": " + key);
					}
					break;
				case "page":
					if (!(gumpDictionary[key].value in returnObj)) {
						returnObj[gumpDictionary[key].value] = {};
						//returnObj[gumpDictionary[key].value].refKey = key;
						//returnObj[gumpDictionary[key].value].array = [];
						//returnObj[gumpDictionary[key].value].array.push(key);
						returnObj[gumpDictionary[key].value].array = [];
						returnObj[gumpDictionary[key].value].array.push(key);
					}
					break;
			}
		}
	});
	//Now adding all the other object references to the structure (for each page/window)
	Object.keys(gumpDictionary).forEach(function (key) {
		if (gumpDictionary[key] != null && !("global" in gumpDictionary[key] && gumpDictionary[key].global)) {
			if (!(gumpDictionary[key].parentPage in returnObj)) {
				Debug("[PageObject][Error] Parent page not in the object yet: " + key);
			} else if (gumpDictionary[key].parent != false) {
				if (gumpDictionary[key].type != "html") {
					returnObj[gumpDictionary[key].parentPage].html[gumpDictionary[key].parent].push(key);
					Debug("[PageObject][Trace] Adding child object to html window (" + gumpDictionary[key].parent + "): " + key);
				} else {
					Debug("[PageObject][Trace] A weird error is ocurring with key: " + key + " It's type was: " + gumpDictionary[key].type);
				}
			} else {
				returnObj[gumpDictionary[key].parentPage].array.push(key);
			}
		}
	});
	return returnObj;
}

function GumpSegmentCreator(gump, gumpDictionary, key) {
	//Handling if the background is default, or in the name of an object in gumpGraphic, else continuing with the value.
	if (gumpDictionary[key].background == "default") {
		gumpDictionary[key].background = gumpGraphic.background_greygold.graphic;
	} else if (gumpDictionary[key].background in gumpGraphic) {
		gumpDictionary[key].background = gumpGraphic[gumpDictionary[key].background].graphic;
	}
	//First checking to see if the object is in a visible column
	var isFiltered = gumpDictionary[key].filtered == null || gumpDictionary[key].filtered == false ? false : true;
	if (!isFiltered && gumpDictionary[key].visible == true && !("columnParent" in gumpDictionary[key] && gumpDictionary[key].columnParent in gumpDictionary && !gumpDictionary[gumpDictionary[key].columnParent].visible)) {
		//Handling if the autoposition is set
		if (!("json" in gumpDictionary)) {
			gumpDictionary["json"] = null;
		}
		//Main switch of how to handle the different types
		gump.AddGlobalColor(false);
		gumpDictionary = GumpPositionHandler_Fast(gumpDictionary, key);

		switch (gumpDictionary[key].type) {
			case "checkbox":
				if (gumpDictionary[key].graphic == "default") {
					gumpDictionary[key].graphic = "checkbox_diamond";
				}
				var graphic = gumpGraphic[gumpDictionary[key].graphic];
				gumpDictionary[key].value = gumpDictionary[key].value == true ? 1 : 0;
				gump.AddCheckbox(gumpDictionary[key].serial, gumpDictionary[key].x, gumpDictionary[key].y, graphic.graphic, graphic.selected, graphic.checked, gumpDictionary[key].value, gumpDictionary[key].color, gumpDictionary[key].text, gumpDictionary[key].txtColor);
				break;
			case "html":
				gump.AddHtmlGump(gumpDictionary[key].serial, gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].width, gumpDictionary[key].height, gumpDictionary[key].background, gumpDictionary[key].hasbackground, gumpDictionary[key].hasScrollbar);
				break;
			case "page":
				gump.AddPage(gumpDictionary[key].value);
				if (gumpDictionary[key].background != false) {
					gump.AddResizepic(gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].background, gumpDictionary[key].width, gumpDictionary[key].height);
				}

				break;
			case "gump_graphic":
				if (gumpDictionary[key].color == null) {
					var theColor = 0;
				} else {
					var theColor = gumpDictionary[key].color;
				}
				gump.AddGumpPic(gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].graphic, theColor, gumpDictionary[key].serial);
				break;
			case "graphic":
				if (gumpDictionary[key].color == null) {
					var theColor = 0;
				} else {
					var theColor = gumpDictionary[key].color;
				}
				gump.AddTilePic(gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].graphic, theColor);
				break;
			case "graphicbutton":
				//This isn't at all functional
				if (gumpDictionary[key].color == null) {
					var theColor = 0;
				} else {
					var theColor = gumpDictionary[key].color;
				}
				//gump.AddResizepic(gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].graphic, 15, 15, gumpDictionary[key].serial);
				gump.AddGumpPic(gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].graphic, 0, gumpDictionary[key].serial, 0, 15, 15);
				//gump.AddTilePic(gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].graphic, theColor);
				break;
			case "plusminus":
				var butGraphic = gumpGraphic[gumpDictionary[key].graphic];
				gump.AddResizepic(gumpDictionary[key].x - 4, gumpDictionary[key].y - 4, gumpDictionary[key].background, gumpDictionary[key].width, gumpDictionary[key].height);
				gump.AddMinMaxButtons(gumpDictionary[key].serial, gumpDictionary[key].x, gumpDictionary[key].y, butGraphic.graphic, 0, gumpDictionary[key].valMin, gumpDictionary[key].valMax, gumpDictionary[key].value);
				gump.SetTextParameters(gumpDictionary[key].showText, gumpDictionary[key].showPos, gumpDictionary[key].color);
				break;
			case "slider":
				if ("valParent" in gumpDictionary[key]) {
					var tempMinMax = MinMaxHandler(gumpDictionary[key].valParent, gumpDictionary);
					gumpDictionary[key].valMin = tempMinMax.valMin;
					gumpDictionary[key].valMax = tempMinMax.valMax;
				}
				var butGraphic = gumpGraphic[gumpDictionary[key].graphic];
				gump.AddSlider(gumpDictionary[key].serial, gumpDictionary[key].x, gumpDictionary[key].y, butGraphic.graphic, butGraphic.graphic, butGraphic.graphic, gumpDictionary[key].background, 1, 0, gumpDictionary[key].width, 0, gumpDictionary[key].valMax, gumpDictionary[key].value);
				gump.SetTextParameters(gumpDictionary[key].showText, gumpDictionary[key].showPos, gumpDictionary[key].color);
				break;
			case "button":
				Debug("[GumpConstructor][Trace] Button action variables: (action / button):" + gumpDictionary[key].butAction + "/" + gumpDictionary[key].butToPage);
				var butGraphic = gumpGraphic[gumpDictionary[key].graphic];
				if (!butGraphic) {
					Debug("[GumpConstructor][Error] Button graphic is invalid: " + gumpDictionary[key].graphic);
				}
				//gump.AddButton(gumpDictionary[key].serial, 0, 0, butGraphic.graphic, butGraphic.graphic, butGraphic.graphic, "0");
				//If not color is provided, setting a default.
				if (gumpDictionary[key].buttonColor == null) {
					gumpDictionary[key].buttonColor == 0;
				}
				//Handling for dynamic buttons
				if (butGraphic.dynamic) {
					if (!("butWidth" in gumpDictionary[key])) {
						gumpDictionary[key].butWidth = butGraphic.butWidth;
					} else {
						butGraphic.butWidth = gumpDictionary[key].butWidth;
					}
					if (!("butHeight" in gumpDictionary[key])) {
						gumpDictionary[key].butHeight = butGraphic.butHeight;
					} else {
						butGraphic.butHeight = gumpDictionary[key].butHeight;
					}

					gump.AddResizepic(gumpDictionary[key].x, gumpDictionary[key].y, butGraphic.graphic, gumpDictionary[key].butWidth, gumpDictionary[key].butHeight, gumpDictionary[key].serial, true);
				} else {
					gump.AddButton(gumpDictionary[key].serial, gumpDictionary[key].x, gumpDictionary[key].y, butGraphic.graphic, butGraphic.selected, butGraphic.pressed, gumpDictionary[key].buttonColor, gumpDictionary[key].butAction, gumpDictionary[key].butToPage);
				}
				if (gumpDictionary[key].text) {
					var textWidth = TextWidth(gumpDictionary[key].text);
					var textHeight = 20;
					var centerCal = butGraphic.butWidth / 2 - textWidth / 2;
					var vertCal = butGraphic.butHeight / 2 - textHeight / 2;
					gump.AddText(gumpDictionary[key].x + butGraphic.butTextOffX + gumpDictionary[key].butTextOffX + centerCal, gumpDictionary[key].y + butGraphic.butTextOffY + gumpDictionary[key].butTextOffY + vertCal, gumpDictionary[key].color, gumpDictionary[key].text);
				}
				break;
			case "textbox":
				gumpDictionary[key].textOffset = (gumpDictionary[key].width - TextWidth(gumpDictionary[key].value)) / 2;
				gump.AddResizepic(gumpDictionary[key].x - 5, gumpDictionary[key].y, gumpDictionary[key].background, gumpDictionary[key].width, gumpDictionary[key].height - 5);
				Debug("[GumpConstructor][Trace] Textbox key/serial:" + key + ": " + gumpDictionary[key].serial);
				gump.AddTextEntry(gumpDictionary[key].serial, gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].color, gumpDictionary[key].value, gumpDictionary[key].width - 7, gumpDictionary[key].height, 50);
				//gump.SetTextEntryPlaceholderText("any");
				break;
			case "text":
				var width = 0;
				if ("width" in gumpDictionary[key]) {
					width = gumpDictionary[key].width;
				}
				gump.AddText(gumpDictionary[key].x + gumpDictionary[key].textOffset, gumpDictionary[key].y, gumpDictionary[key].color, gumpDictionary[key].text, width, gumpDictionary[key].serial);
				break;
			case "htmltext":
				var width = 0;
				if ("width" in gumpDictionary[key]) {
					width = gumpDictionary[key].width;
				}
				gump.AddHtmlText(gumpDictionary[key].x + gumpDictionary[key].textOffset, gumpDictionary[key].y, width, gumpDictionary[key].height, gumpDictionary[key].color, gumpDictionary[key].text, gumpDictionary[key].serial);
				break;
			case "column":
				gump.AddText(gumpDictionary[key].x + gumpDictionary[key].textOffset, gumpDictionary[key].y, gumpDictionary[key].color, gumpDictionary[key].text);
				break;
			case "radio":
				var butGraphic = gumpGraphic[gumpDictionary[key].graphic];
				var state = gumpDictionary[key].value == true ? 1 : 0;
				gump.AddRadio(gumpDictionary[key].serial, gumpDictionary[key].x, gumpDictionary[key].y, butGraphic.graphic, butGraphic.selected, butGraphic.checked, state, 0, gumpDictionary[key].text, gumpDictionary[key].color);
				break;
			case "combobox":
				gump.AddComboBox(gumpDictionary[key].serial, gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].background, 0, gumpDictionary[key].background, gumpDictionary[key].width, -3, gumpDictionary[key].droplist.length);
				for (var i = 0; i < gumpDictionary[key].droplist.length; i++) {
					var selection = 0;
					if (parseInt(gumpDictionary[key].value) == i) {
						selection = 1;
					}
					gump.AddComboBoxText(gumpDictionary[key].droplist[i][1], 0, selection);
					//Debug("[GumpConstructor[Trace] Adding item to the gump combobox: " + gumpDictionary[key].droplist[i][1]);
				}
				break;
			case "background":
				gump.AddResizepic(gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].background, gumpDictionary[key].width, gumpDictionary[key].height);
				break;
			case "line":
				gump.AddLine(gumpDictionary[key].x, gumpDictionary[key].y, gumpDictionary[key].x + gumpDictionary[key].width, gumpDictionary[key].y, "#CEA552", 2);
				break;
			case "main":
				break;
			case "skip":
				break;
			default:
				Debug("[GenerateGump][Error] Invalid object type: " + gumpDictionary[key].type);
		}
		if ("tooltip" in gumpDictionary[key] && gumpDictionary[key].tooltip != false) {
			gump.AddTooltip(gumpDictionary[key].tooltip);
		}
	}
	return gump;
}

//Handles the position of the object in the gump, if the autoPosition variable is set to true
//The "PosVariable" is stored main JSON file, and flagged as global.  In it there is a dictionary of pages, and in that dictionary of pages is
//a dictionary of rows.  In that row is stored the current X position. Y is based only on the number of the row and the set row heigh.
function GumpPositionHandler_Fast(gumpDictionary, key) {
	var theObj = gumpDictionary[key];
	if ("autoPosition" in theObj && theObj.autoPosition == true) {
		if ("PosVariable" in gumpDictionary) {
			var pos = gumpDictionary.PosVariable;
		} else {
			Debug("[GumpPositionHandler][Trace] No PosVariable data, creating it.");
			gumpDictionary.PosVariable = {};
			gumpDictionary.PosVariable.global = true;
			gumpDictionary.PosVariable.pages = {};
			if ("rowHeight" in theObj) {
				gumpDictionary.PosVariable.rowHeight = theObj.rowHeight;
			} else {
				gumpDictionary.PosVariable.rowHeight = 35;
			}
			var pos = gumpDictionary.PosVariable;
		}
		//Checking/creating a new page if necessary
		if (!(theObj.parentPage in pos.pages)) {
			pos.pages[theObj.parentPage] = {};
		}
		//Setting the object page to zero if that variable doesn't exist, similar for the x offset.
		theObj.autoRow = theObj.autoRow == null ? 0 : theObj.autoRow;
		theObj.xOffset = theObj.xOffset == null ? 0 : theObj.xOffset;
		//Checking if the row is in the page, creating it if not, and adding the offset.
		if (!(theObj.autoRow in pos.pages[theObj.parentPage])) {
			pos.pages[theObj.parentPage][theObj.autoRow] = theObj.xOffset;
		} else {
			pos.pages[theObj.parentPage][theObj.autoRow] = parseInt(pos.pages[theObj.parentPage][theObj.autoRow]) + parseInt(theObj.xOffset);
		}
		//Setting the X and Y of the object to be returned based on the current position.
		Debug("[GumpPositionHandler_Fast][Trace] Object Name / X :" + theObj.name + " / " + theObj.parentPage + " / " + parseInt(pos.pages[theObj.parentPage][theObj.autoRow]));
		theObj.x = parseInt(pos.pages[theObj.parentPage][theObj.autoRow]);
		theObj.y = parseInt(theObj.autoRow * pos.rowHeight);
		if ("yOffset" in theObj && theObj.yOffset > 0) {
			theObj.y += theObj.yOffset;
		}
		//Now updating the row position to include this object to be exported to the JSON.
		var width = 50;
		if (theObj.type == "text") {
			width = TextWidth(theObj.text);
		}
		if (theObj.width != 0 && theObj.width != null) {
			width = theObj.width;
		}
		pos.pages[theObj.parentPage][theObj.autoRow] += width;
		//Now saving all the calculations we've done to the Posvariabl global, and the coordinates to the object itself
		gumpDictionary.PosVariable = pos;
		gumpDictionary[key] = theObj;
		return gumpDictionary;
	} else {
		Debug("[GumpPositionHandler_Fast][Trace] autoPosition not set to true, returning the same object");
		return gumpDictionary;
	}
}

//Should be able to delete this soon, fixed a problem handling html windows
function GumpConstructor_Fast_old(gump, gumpDictionary, pageArray) {
	Object.keys(pageArray).forEach(function (page) {
		for (var i = 0; i < pageArray[page].array.length; i++) {
			if (gumpDictionary[pageArray[page].array[i]].type != "html") {
				Debug("[GumpConstructor_Fast][Trace] Create Gump Object (page): " + pageArray[page].array[i] + "(" + page + ")");
				gump = GumpSegmentCreator(gump, gumpDictionary, pageArray[page].array[i]);
			}
		}
		if ("html" in pageArray[page]) {
			Object.keys(pageArray[page].html).forEach(function (htmlWindow) {
				gump.Select("gump");
				Debug("[GumpConstructor_Fast][Info] Creating HTML Window: " + pageArray[page].html[htmlWindow][0]);
				gump = GumpSegmentCreator(gump, gumpDictionary, pageArray[page].html[htmlWindow][0]);

				gump.Select("gump", gumpDictionary[htmlWindow].serial - 1);

				gump.Select("htmlgump", gumpDictionary[htmlWindow].serial);
				Debug("[GumpConstructor_Fast][Info] HTML Window found (" + htmlWindow + ", " + +gumpDictionary[htmlWindow].serial + "), create associated objects (" + pageArray[page].html[htmlWindow].length + ").");
				for (var i = 1; i < pageArray[page].html[htmlWindow].length; i++) {
					Debug("[GumpConstructor_Fast][Info] HTML Page / Object: " + page + " / " + pageArray[page].html[htmlWindow][i]);
					gump = GumpSegmentCreator(gump, gumpDictionary, pageArray[page].html[htmlWindow][i]);
				}
			});
		}
	});
	return gump;
}
