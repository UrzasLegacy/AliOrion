//--#IDOC Scripts
function HitBarrels() {
	while (!Player.Dead()) {
		var barrels = Orion.FindType("0x0FAE|0x0E77|0x1EB5", "-1", ground, "near", "24", " ");
		var barrel;
		if (barrels.length) {
			barrel = Orion.FindObject(barrels[0]);
			if (barrel.Serial) {
				var h = barrel.X();
				var j = barrel.Y();
				if (barrel.Distance() > 1) Orion.WalkTo(h, j, 0);
				else Orion.Attack(barrel.Serial());
				Orion.Wait(250);
			}
		}
		Orion.Wait(250);
	}
}

function HidePlayers() {
	var filter = "energy vortex|rising col";
	while (true) {
		var peeps = Orion.FindType(any, any, ground, "live|ignoreself", 24, "blue");
		var creatures = Orion.FindTypeEx(any, any, ground, "live|ignoreself", 24, "red|criminal|gray");
		for (i = 0; i < peeps.length; i++) {
			Orion.Hide(peeps[i]);
		}
		for (i = 0; i < creatures.length; i++) {
			if (Orion.Contains(creatures[i].Name(), filter)) {
				Orion.Hide(creatures[i].Serial());
			}
		}

		Orion.Wait(500);
	}
}
