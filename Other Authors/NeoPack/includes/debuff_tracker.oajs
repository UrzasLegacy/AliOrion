		var graphic = jMsg.Text().match(/graphic=(0x[0-9A-F]{4})/i)[1];
		var actionX = jMsg.Text().match(/dest_x=([0-9]{1,4})/i)[1];
		var actionY = jMsg.Text().match(/dest_y=([0-9]{1,4})/i)[1];
