			var graphY = "0";
			for (var i = 0; i < 100; i++) {
				//var nextMsg = Orion.JournalLine(jMsg.FindTextID() + i)
				//Debug(Orion.JournalCount())
				var nextMsg = Orion.JournalLine(Orion.JournalCount() - i);
				if (nextMsg != null) {
					if (nextMsg.Text() == jMsg.Text()) {
						break;
					}
					//Debug(nextMsg.Text())
					/*if (effects[graphic].nextGraphic != false ){
              //Checking to see if the next
              if(Orion.Contains(nextMsg.Text(),"graphic=")){
                var nextGraphic = nextMsg.Text().match(/graphic=(0x[0-9A-F]{4})/i)[1];
                var nextSerial = nextMsg.Text().match(/src_serial=(0x[0-9A-F]{8})/i)[1];
                if(effects[graphic].nextGraphic == nextGraphic && nextSerial == serial){
                  graphCheck = true;
                  graphX = nextMsg.Text().match(/dest_x=([0-9A-F]{1,4})/i)[1];
                  graphY = nextMsg.Text().match(/dest_y=([0-9A-F]{1,4})/i)[1];
                  if(graphCheck == true && soundCheck == true){
                    break;
                  }
                }
              }
            }*/
					if (effects[graphic].sound != false) {
						//Using the second graphic if there is one, otherwise original action/graphic
						/*if(effects[graphic].nextGraphic != false){
                var soundRefX = graphX;
                var soundRefY = graphY;
              }
              else{
                var soundRefX = actionX;
                var soundRefY = actionY;
              }*/
						var soundRefX = actionX;
						var soundRefY = actionY;
						//Checking to see if the sound matches
						if (Orion.Contains(nextMsg.Text(), "soundecho")) {
							var nextSound = nextMsg.Text().match(/id=(0x[0-9A-F]{4})/i)[1];
							soundX = nextMsg.Text().match(/x=([0-9A-F]{1,4})/i)[1];
							soundY = nextMsg.Text().match(/y=([0-9A-F]{1,4})/i)[1];
							//Orion.Print(effects[graphic].sound + " " + nextSound + ' ' + soundX + ' ' + soundY + " " + soundRefX + " " + soundRefY)
							if (effects[graphic].sound == nextSound && soundX == soundRefX && soundRefY == soundY) {
								soundCheck = true;
								if (graphCheck == true && soundCheck == true) {
									break;
								}
							}
						}
					}
				}
				//else{
				//  break;
				//}
			}
			//Orion.Print("GC: " + graphCheck + " Sound:" + soundCheck);
			if (effects[graphic].nextGraphic != false && graphCheck == false) {
				return false;
			}
