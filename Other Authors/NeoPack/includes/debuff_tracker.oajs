					cdTimerID,
					effects[graphic].cdTime - Orion.GetPing("average"),
					"AboveChar",
					"Line|Bar",
					"",
					effects[graphic].cdX,
					effects[graphic].cdY,
					effects[graphic].cdText,
					effects[graphic].cdFont,
					effects[graphic].cdBar
				);
				Orion.DisplayTimerSetObject(cdTimerID, serial);
				TimerIconSetup(cdTimerID, effects[graphic].name);
				Orion.DisplayTimerSetSize(cdTimerID, 30, 10);
				if (effects[graphic].remove != false) {
					Orion.RemoveDisplayTimer(effects[graphic].remove + "_timerID_" + serial);
				}
			}
		}
	}
}

//Someone elses debuff tracker
function CrunchSlayer2() {
	var howFarBackInJournal = 60;
	while (true) {
		var targetsToTrack = Orion.FindTypeEx(
			"0x02EC|0x029A|0x029B|0x025D|0x025E|0x0190|0x0191|0x0192|0x0193|0x03DB|0x03DF|0x03E2|0x04E6|0x00DC|0x00F6|0x00DB|0x0019|0x0084|0x007A",
			"-1",
			"ground",
			" ",
			24,
			"gray|criminal|orange|red|blue"
		);
		for (var i = 0; i < targetsToTrack.length; i++) {
			// Add your cooldown tracking logic here
			var targetsToTrack = Orion.FindTypeEx(
				"0x02EC|0x029A|0x029B|0x025D|0x025E|0x0190|0x0191|0x0192|0x0193|0x03DB|0x03DF|0x03E2|0x04E6|0x00DC|0x00F6|0x00DB|0x0019|0x0084|0x007A",
				"-1",
				ground,
				" ",
				24,
				"gray|criminal|orange|red|blue"
			);
			var mortalArray = [];
			var splinterArray = [];
			var splinterCooldownArray = [];
			var splinterEnd = [];
			var appleArray = [];
			var evasionArray = [];
			var evasionCooldownArray = [];
			var disarmArray = [];
			var disarmCooldownArray = [];
			var sleepArray = [];
			var paraArray = [];
			for (i = 0; i < targetsToTrack.length; i++) {
				if (
					Orion.InJournal("graphic=0x3728", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					Orion.InJournal("id=0x01DF", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now())
				) {
					var effect = Orion.InJournal("0x3728", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now());
					var effectText = effect.Text();
					var effectSerial = /src_serial=.{10}/.exec(effectText);
					var effectReplace = effectSerial[0].replace(/^.{11}/, "");
					var effectSerialTwo = /.{10}/.exec(effectReplace);
					splinterCooldownArray[i] = effectSerialTwo + "splinterCooldown";
					splinterArray[i] = effectSerialTwo + "Splinter";
					Orion.AddDisplayTimer(splinterCooldownArray[i], 20000, "UnderChar", "Line|Bar", "", 0, 20, any, -1, "0xFF0000FE");
					Orion.DisplayTimerSetObject(splinterCooldownArray[i], effectSerialTwo);
					Orion.DisplayTimerSetSize(splinterCooldownArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(splinterCooldownArray[i], false);
					Orion.AddDisplayTimer(splinterArray[i], 4000, "UnderChar", "Line|Bar", "", 0, 20, any, -1, "0x000000FE");
					Orion.DisplayTimerSetObject(splinterArray[i], effectSerialTwo);
					Orion.DisplayTimerSetSize(splinterArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(splinterArray[i], false);
					Orion.ClearJournal("0x3728", "sys");
					Orion.Wait(20);
				} else if (
					Orion.InJournal("graphic=0x3779", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					Orion.InJournal("id=0x0657", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now())
				) {
					var sleepEffect = Orion.InJournal("0x3779", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now());
					var sleepEffectText = sleepEffect.Text();
					var sleepEffectSerial = /src_serial=.{10}/.exec(sleepEffectText);
					var sleepEffectReplace = sleepEffectSerial[0].replace(/^.{11}/, "");
					var sleepEffectSerialTwo = /.{10}/.exec(sleepEffectReplace);
					sleepArray[i] = sleepEffectSerialTwo + "sleep";
					Orion.AddDisplayTimer(sleepArray[i], 13000, "UnderChar", "Line|Bar", "", 0, 40, any, -1, "0x00FFFFFE");
					Orion.DisplayTimerSetObject(sleepArray[i], sleepEffectSerialTwo);
					Orion.DisplayTimerSetSize(sleepArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(sleepArray[i], false);
					Orion.ClearJournal(sleepEffectSerialTwo, "sys");
					Orion.Wait(20);
				} else if (
					Orion.InJournal("graphic=0x376A", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					(Orion.InJournal("id=0x0237", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) ||
						Orion.InJournal("id=0x0204", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) ||
						Orion.InJournal("id=0x023C", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) ||
						Orion.InJournal("id=0x0537", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()))
				) {
					var paraEffect = Orion.InJournal("0x376A", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now());
					var paraEffectText = paraEffect.Text();
					var paraEffectSerial = /src_serial=.{10}/.exec(paraEffectText);
					var paraEffectReplace = paraEffectSerial[0].replace(/^.{11}/, "");
					var paraEffectSerialTwo = /.{10}/.exec(paraEffectReplace);
					paraArray[i] = paraEffectSerialTwo + "para";
					Orion.AddDisplayTimer(paraArray[i], 13000, "UnderChar", "Line|Bar", "", 0, 40, any, -1, "0x000080FE");
					Orion.DisplayTimerSetObject(paraArray[i], paraEffectSerialTwo);
					Orion.DisplayTimerSetSize(paraArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(paraArray[i], false);
					Orion.ClearJournal("0x376A", "sys");
					Orion.Wait(20);
				} else if (
					Orion.InJournal("graphic=0x37BE", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					Orion.InJournal("id=0x03B9", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now())
				) {
					var disarmEffect = Orion.InJournal("0x37BE", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now());
					var disarmEffectText = disarmEffect.Text();
					var disarmEffectSerial = /src_serial=.{10}/.exec(disarmEffectText);
					var disarmEffectReplace = disarmEffectSerial[0].replace(/^.{11}/, "");
					var disarmEffectSerialTwo = /.{10}/.exec(disarmEffectReplace);
					disarmArray[i] = disarmEffectSerialTwo + "disarm";
					disarmCooldownArray[i] = disarmEffectSerialTwo + "disarmCooldown";
					Orion.AddDisplayTimer(disarmCooldownArray[i], 20000, "UnderChar", "Line|Bar", "", 0, 35, any, -1, "0x00FF00FE");
					Orion.DisplayTimerSetObject(disarmCooldownArray[i], disarmEffectSerialTwo);
					Orion.DisplayTimerSetSize(disarmCooldownArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(disarmCooldownArray[i], false);
					Orion.AddDisplayTimer(disarmArray[i], 5000, "UnderChar", "Line|Bar", "", 0, 35, any, -1, "0x000000FE");
					Orion.DisplayTimerSetObject(disarmArray[i], disarmEffectSerialTwo);
					Orion.DisplayTimerSetSize(disarmArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(disarmArray[i], false);
					Orion.ClearJournal("0x37BE", "sys");
					Orion.Exec("CallForAttackDisarmedTarget", true, disarmEffectSerialTwo);
					Orion.Wait(20);
				} else if (
					Orion.InJournal("graphic=0x3709", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					Orion.InJournal("graphic=0x3776", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					Orion.InJournal("id=0x00F6", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					Orion.InJournal("id=0x01F7", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					Orion.InJournal("id=0x003", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now())
				) {
					var appleEffect = Orion.InJournal("0x3709", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now());
					var appleEffectText = appleEffect.Text();
					var appleEffectSerial = /src_serial=.{10}/.exec(appleEffectText);
					var appleEffectReplace = appleEffectSerial[0].replace(/^.{11}/, "");
					var appleEffectSerialTwo = /.{10}/.exec(appleEffectReplace);
					appleArray[i] = appleEffectSerialTwo + "Apple";
					Orion.AddDisplayTimer(appleArray[i], 30000, "UnderChar", "Line|Bar", "", 0, 25, any, -1, "0x008080FE");
					Orion.DisplayTimerSetObject(appleArray[i], appleEffectSerialTwo);
					Orion.DisplayTimerSetSize(appleArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(appleArray[i], false);
					Orion.ClearJournal("0x3709", "sys");
					Orion.Wait(20);
				} else if (
					Orion.InJournal("graphic=0x376A", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now()) &&
					Orion.InJournal("id=0x051B", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now())
				) {
					var evasionEffect = Orion.InJournal("0x376A", "sys", any, any, Orion.Now() - howFarBackInJournal, Orion.Now());
					var evasionEffectText = evasionEffect.Text();
					var evasionEffectSerial = /src_serial=.{10}/.exec(evasionEffectText);
					var evasionEffectReplace = evasionEffectSerial[0].replace(/^.{11}/, "");
					var evasionEffectSerialTwo = /.{10}/.exec(evasionEffectReplace);
					evasionArray[i] = evasionEffectSerialTwo + "evasion";
					evasionCooldownArray[i] = evasionEffectSerialTwo + "evasionCooldown";
					Orion.AddDisplayTimer(evasionArray[i], 26000, "UnderChar", "Line|Bar", "", 0, 30, any, -1, "0xFF00FFFE");
					Orion.DisplayTimerSetObject(evasionArray[i], evasionEffectSerialTwo);
					Orion.DisplayTimerSetSize(evasionArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(evasionArray[i], false);
					Orion.AddDisplayTimer(evasionCooldownArray[i], 5000, "UnderChar", "Line|Bar", "", 0, 30, any, -1, "0x000000FE");
					Orion.DisplayTimerSetObject(evasionCooldownArray[i], evasionEffectSerialTwo);
					Orion.DisplayTimerSetSize(evasionCooldownArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(evasionCooldownArray[i], false);
					Orion.ClearJournal("0x376A", "sys");
					Orion.Wait(20);
				} else if (targetsToTrack[i].YellowHits()) {
					mortalArray[i] = targetsToTrack[i].Serial() + "Mortal";
					Orion.AddDisplayTimer(mortalArray[i], 8000, "UnderChar", "Line|Bar", "", 0, 15, any, -1, "0xFFFF00FE");
					Orion.DisplayTimerSetObject(mortalArray[i], targetsToTrack[i].Serial());
					Orion.DisplayTimerSetSize(mortalArray[i], 20, 0);
					Orion.DisplayTimerSetShowTime(mortalArray[i], false);
					Orion.Wait(20);
				}
			}
			Orion.Wait(20);
		}
	}
}
