	tempDict[tempSkill] = ColumnObject(tempSkill);
	var tempSkill = "HPR";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	var tempSkill = "SR";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	tempDict[tempSkill].hide = true;
	var tempSkill = "Str";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	var tempSkill = "Int";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	var tempSkill = "Dex";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	var tempSkill = "HPI";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	var tempSkill = "MI";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	var tempSkill = "SI";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	tempDict[tempSkill].hide = true;
	var tempSkill = "Inten.";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	tempDict[tempSkill].hide = false;
	tempDict[tempSkill].order = 19;
	var tempSkill = "Price";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	tempDict[tempSkill].hide = false;
	tempDict[tempSkill].order = 20;
	tempDict[tempSkill].itemProp = false;
	tempDict[tempSkill].type = "entry";
	var tempSkill = "Nearby";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	tempDict[tempSkill].hide = true;
	tempDict[tempSkill].itemProp = false;
	tempDict[tempSkill].order = 21;

	return tempDict;
}

