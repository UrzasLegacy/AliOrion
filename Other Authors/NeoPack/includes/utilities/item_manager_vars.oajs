itemManager_defaultvars = [];

//Revision number
var currentRevision = 1; //This will be used when writing/pulling "database" file so that older versions aren't corrupted by newer ones.

//Structure for item objects
function itemMgr_ItemObj(serial) {
	var test = {};
	test.serial = serial;
	test.name = null;
	test.container = null;
	test.posX = null;
	test.posY = null;
	test.layer = null;
	test.intesity = null;
	test.graphic = null;
	test.studBone = false;
	test.totalMods = 0;
	test.hasDurability = true;
	test.properties = null;

	return test;
}

function itemMgr_PropertyClass(propName, muxArmor, muxJewel, muxWep) {
	var test = {};
	test.value = false;
	test.searchName = propName;
	test.intensity = 0;
	test.existOnly = false; //Checking to see if the property exists or a value
	test.muxArmor = 1;
	test.muxJewel = 1;
	test.muxWep = 1;
	test.totalMod = true;
	test.isSkill = false;
	test.bonus = 0;
	test.bonusLevel = 9999;
	return test;
}

function itemMgr_ColumnSetup() {
	var tempDict = {};
	var tempSkill = "Sel.";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	tempDict[tempSkill].width = 40;
	tempDict[tempSkill].textOffset = 10;
	tempDict[tempSkill].order = 0;
	var tempSkill = "Item";
	tempDict[tempSkill] = ColumnObject(tempSkill);
	tempDict[tempSkill].ref = "Graphic";
