//--#Targetting

//@@Scrolls through all mobiles on screen for the notoriety selected in the Gump.
//Targetting,PvP
function SelectTargetScrolling() {
	forward = true;
	var lastInd, lastDist, highVal;

	if (Orion.GetGlobal("forward") != String(forward)) {
		Orion.SetGlobal("forward", String(forward));
		Orion.IgnoreReset();
		Orion.Ignore(Orion.ClientLastTarget());
	}
	typefilter = "live|ignoreself|ignorefriends|";
	if (Orion.GetGlobal("note_humanonly") == "true") {
		typefilter += "human|";
	}
	notefilter = ActiveNotoriety();
	var highlightLTcolor = Orion.GetGlobal("targetHighlightColor");
	for (var i = 0; i < 2; i++) {
		var humanArr = Orion.FindType("-1", "-1", ground, typefilter, 18, notefilter);
		var creatureArr = Orion.FindType("0x0084|0x007A|0x00F6|0x0019|0x00DC|0x00DB|0x04E6", "-1", ground, "", 18, notefilter);
		var mobArr = humanArr.concat(creatureArr);
		if (mobArr.length) {
			forward ? ((highVal = 18), (lastDist = 0)) : ((highVal = 0), (lastDist = 18));

			Orion.GetGlobal("lastDist") == "" ? (lastDist = lastDist) : (lastDist = Number(Orion.GetGlobal("lastDist")));

			for (var ii = 0; ii < mobArr.length; ii++) {
				var dist = Orion.GetDistance(mobArr[ii]);

				if (forward && dist <= highVal && dist >= lastDist) {
					highVal = dist;
					lastInd = ii;
				} else if (!forward && dist >= highVal && dist <= lastDist) {
					highVal = dist;
					lastInd = ii;
				}
			}

			if (lastInd != undefined) {
				Orion.SetGlobal("lastDist", highVal);
				Orion.RemoveHighlightCharacter(Orion.GetGlobal("LTHighlight"), true);
				//Orion.ClearHighlightCharacters();

				Orion.ClientLastTarget(mobArr[lastInd]);
				//Orion.TargetSystemSerial(mobArr[lastInd]);
				var currtar = Orion.FindObject(mobArr[lastInd]);
				Orion.CharPrint(Player.Serial(), "48", "Target:[" + currtar.Name() + "]");
				Orion.SetGlobal("LTHighlight", mobArr[lastInd]);
				Orion.AddHighlightCharacter(mobArr[lastInd], highlightLTcolor, true);
				CurrTarGump(currtar.Name(), currtar.Serial());
				Orion.Ignore(mobArr[lastInd]);
				return;
			}
		}

		if ((!mobArr.length && i == 0) || lastInd == undefined) {
			Orion.SetGlobal("lastDist", "");
			Orion.IgnoreReset();
		}
	}

	Orion.Print("No enemies!");
}
//@@Scrolls through all blue,grey, or criminal human mobiles on screen.
//Targetting
function SelectTargetScrollingBlue(forward) {
	var lastInd, lastDist, highVal;

	if (Orion.GetGlobal("forward") != String(forward)) {
		Orion.SetGlobal("forward", String(forward));
		Orion.IgnoreReset();
		Orion.Ignore(Orion.ClientLastTarget());
	}

	for (var i = 0; i < 2; i++) {
		var mobArr = Orion.FindType("-1", "-1", ground, "live|ignoreself|ignorefriends|human", 18, "blue|grey|criminal");

		if (mobArr.length) {
			forward ? ((highVal = 18), (lastDist = 0)) : ((highVal = 0), (lastDist = 18));

			Orion.GetGlobal("lastDist") == "" ? (lastDist = lastDist) : (lastDist = Number(Orion.GetGlobal("lastDist")));

			for (var ii = 0; ii < mobArr.length; ii++) {
				var dist = Orion.GetDistance(mobArr[ii]);

				if (forward && dist <= highVal && dist >= lastDist) {
					highVal = dist;
					lastInd = ii;
				} else if (!forward && dist >= highVal && dist <= lastDist) {
					highVal = dist;
					lastInd = ii;
				}
			}

			if (lastInd != undefined) {
				Orion.SetGlobal("lastDist", highVal);
				Orion.RemoveHighlightCharacter(Orion.GetGlobal("LTHighlight"), true);
				//Orion.ClientLastAttack(mobArr[lastInd]);
				Orion.ClientLastTarget(mobArr[lastInd]);
				//Orion.TargetSystemSerial(mobArr[lastInd]);
				var currtar = Orion.FindObject(mobArr[lastInd]);
				Orion.ClientLastTarget(mobArr[lastInd]);
				Orion.CharPrint(Player.Serial(), "2119", "Target:[" + currtar.Name() + "]");
				Orion.SetGlobal("LTHighlight", mobArr[lastInd]);
				Orion.AddHighlightCharacter(mobArr[lastInd], "1152", true);
				Orion.AddDisplayTimer(101, 30000, "Top", "Rectangle|Bar", currtar.Name(), 0, 0, "0xFFFF", 4, "green");
				Orion.Ignore(mobArr[lastInd]);
				return;
			}
		}

		if ((!mobArr.length && i == 0) || lastInd == undefined) {
			Orion.SetGlobal("lastDist", "");
			Orion.IgnoreReset();
		}
	}

	Orion.Print("No enemies!");
}
//@@Sets the nearest OJ as last target and highlights them glacial.
//PvP,Targetting
function TargetNearestEnemy() {
	var humanArr = Orion.FindType("-1", "-1", ground, "live|ignoreself|ignorefriends|human|near", 20, "orange");
	var creatureArr = Orion.FindType("0x0084|0x007A|0x00F6|0x0019|0x00DC|0x00DB|0x04E6", "-1", ground, "", 18, "orange");
	var mobArr = humanArr.concat(creatureArr);

	if (mobArr.length) {
		Orion.ClearHighlightCharacters(true);

		//Orion.ClientLastAttack(mobArr[lastInd]);
		var currtar = Orion.FindObject(mobArr[0]);
		Orion.ClientLastTarget(currtar.Serial());
		Orion.CharPrint(Player.Serial(), "48", "Target:[" + currtar.Name() + "]");
		Orion.SetGlobal("LTHighlight", mobArr[0]);
		Orion.AddHighlightCharacter(mobArr[0], "1152", true);
		Orion.AddDisplayTimer(101, 30000, "Top", "Rectangle|Bar", currtar.Name(), 0, 0, "0xFFFF", 4, "green");
		//Orion.Ignore(mobArr[lastInd]);
		//Orion.Attack(mobArr[0]);
	}
}
//@@Attacks nearest OJ human.
//Targetting,PvP
function AttackNearestEnemy() {
	var mobArr = Orion.FindType("-1", "-1", ground, "live|ignoreself|ignorefriends|human|near", 20, "criminal|orange|red");

	if (mobArr.length) {
		var currtar = Orion.FindObject(mobArr[0]);
		Orion.CharPrint(Player.Serial(), "48", "Attacking:[" + currtar.Name() + "]");
		Orion.Attack(currtar.Serial());
	}
}

//@@Attacks nearest mobile (human or creature).
//Targetting,PvM,PvP
function AttackNearest() {
	while (true) {
		var mobArr = Orion.FindType("-1", "-1", ground, "live|ignoreself|ignorefriends|near", 20, "criminal|gray|orange|red");

		if (mobArr.length) {
			//Orion.Print(mobArr.length);
			//for (var i = 0; i < mobArr.length; i++) {
			//	Orion.Attack(mobArr[i]);
			//	Orion.Wait(100);
			//}
			var currtar = Orion.FindObject(mobArr[0]);
			Orion.CharPrint(Player.Serial(), "48", "Attacking:[" + currtar.Name() + "]");
			Orion.Attack(currtar.Serial());
		}
		Orion.Wait(500);
	}
}
//@@Scrolls through the closest three (variable) targets to the Player as default or a selected Caller.
//PvP,Targetting
function ScrollNearTargets_delete() {
	var scrollCount = 3;
	var humanArr = Orion.FindTypeEx("-1", "-1", "ground", "live|ignoreself|ignorefriends", 30, "orange|red");
	var creatureArr = Orion.FindTypeEx("0x0084|0x007A|0x00F6|0x0019|0x00DC|0x00DB|0x04E6", "-1", "ground", "", 30, "orange|red");
	var mobArr = humanArr.concat(creatureArr);
	mobArr.sort(function (a, b) {
		return a.Distance() - b.Distance();
	});
	var curPos = Orion.GetGlobal("OJScrollPosition");
	curPos = curPos == "" ? 0 : curPos;
	if (curPos >= mobArr.length || curPos >= scrollCount) {
		if (mobArr.length > 0) {
			PvPSetTarget(mobArr[0]);
			HighlightCaller();
			Orion.SetGlobal("OJScrollPosition", 1);
		} else {
			Orion.SetGlobal("OJScrollPosition", 0);
		}
	} else {
		if (mobArr[curPos] && mobArr[curPos].Serial() != Orion.GetGlobal("LTHighlight")) {
			PvPSetTarget(mobArr[curPos]);
			Orion.SetGlobal("OJScrollPosition", ++curPos);
		} else {
			curPos++;
			if (curPos >= scrollCount) {
				curPos = 0;
			}
			PvPSetTarget(mobArr[curPos]);
			Orion.SetGlobal("OJScrollPosition", ++curPos);
		}
	}
}

//@@Set the caller for PvP.  Used for the 'ScrollNearTargets' function.
//PvP,Targetting
function SetCaller() {
	var highlightCaller = Orion.GetGlobal("doCallerHighlight") == "true" ? true : false;
	var highlightCallerColor = Orion.GetGlobal("callerHighlightColor") == "" ? 1153 : Orion.GetGlobal("callerHighlightColor");
	if (highlightCaller) {
		Orion.WaitForAddObject("CallerCharacter");
		var tempTarget = Orion.FindObject("CallerCharacter");
		if (tempTarget) {
			Orion.RemoveHighlightCharacter(Orion.GetGlobal("LeadHighlight"), true);
			Orion.AddHighlightCharacter(tempTarget.Serial(), highlightCallerColor, true);
			Orion.SetGlobal("LeadHighlight", tempTarget.Serial());
		} else {
			Orion.Print("You'll need to try to set a caller again.");
		}
	} else {
		Orion.Print("You need to turn on 'Target Caller' in the Gump, under Targetting.");
		Orion.RemoveHighlightCharacter(Orion.GetGlobal("LeadHighlight"), true);
	}
}

//@@Set the caller for PvP.  Used for the 'ScrollNearTargets' function. This version must have the serial passed in
//PvP,Targetting
function SetCaller_Serial(serial) {
	var highlightCaller = Orion.GetGlobal("doCallerHighlight") == "true" ? true : false;
	var highlightCallerColor = Orion.GetGlobal("callerHighlightColor") == "" ? 1153 : Orion.GetGlobal("callerHighlightColor");
	if (highlightCaller) {
		Orion.RemoveHighlightCharacter(Orion.GetGlobal("LeadHighlight"), true);
		Orion.AddHighlightCharacter(serial, highlightCallerColor, true);
		Orion.SetGlobal("LeadHighlight", serial);
	} else {
		Orion.Print("You need to turn on 'Target Caller' in the Gump, under Targetting.");
		Orion.RemoveHighlightCharacter(Orion.GetGlobal("LeadHighlight"), true);
	}
}

//@@Returns the distance between the caller selected with 'SetCaller' and a set of coordinates. Used for sorting the distance of the 'ScrollNearTargets' function.
//Programming,Support
function CallerDistance(tarX, tarY) {
	var referenceChar = Orion.GetGlobal("LeadHighlight") == "" ? Player : Orion.FindObject(Orion.GetGlobal("LeadHighlight"));
	if (!referenceChar) {
		referenceChar = Player;
	}
	return TwoObjectDistance(referenceChar.X(), referenceChar.Y(), tarX, tarY);
}

//@@Scrolls through the closest, variable number of OJ targets (default 3).  If a caller is set, it will scroll through the 3 nearest targets to the caller (and player if caller not on screen).
//PvP,Targetting
function ScrollNearTargets() {
	var scrollCount = 3;
	var humanArr = Orion.FindTypeEx("-1", "-1", "ground", "live|ignoreself|ignorefriends", 20, "orange|red");
	var creatureArr = Orion.FindTypeEx("0x0084|0x007A|0x00F6|0x0019|0x00DC|0x00DB|0x04E6", "-1", "ground", "", 18, "orange|red");
	var mobArr = humanArr.concat(creatureArr);

	mobArr.sort(function (a, b) {
		//return a.Distance() - b.Distance();
		return CallerDistance(a.X(), a.Y()) - CallerDistance(b.X(), b.Y());
	});
	var curPos = Orion.GetGlobal("OJScrollPosition");
	curPos = curPos == "" ? 0 : curPos;
	if (mobArr.length > 0) {
		if (curPos >= mobArr.length || curPos >= scrollCount) {
			if (mobArr.length > 0) {
				PvPSetTarget(mobArr[0]);
				Orion.SetGlobal("OJScrollPosition", 1);
			} else {
				Orion.SetGlobal("OJScrollPosition", 0);
			}
		} else {
			if (mobArr[curPos].Serial() != Orion.GetGlobal("LTHighlight")) {
				PvPSetTarget(mobArr[curPos]);
				Orion.SetGlobal("OJScrollPosition", ++curPos);
			} else {
				curPos++;
				if (curPos >= scrollCount) {
					curPos = 0;
				}
				PvPSetTarget(mobArr[curPos]);
				Orion.SetGlobal("OJScrollPosition", ++curPos);
			}
		}
	} else {
		Orion.Print("No nearby targets.");
	}
}

//@@Support function that takes a passed in object class, sets highlights them to the color that has been selected in the gump (or glacial as default) and sets the object as your Last Target.
//Support,Programming
function PvPSetTarget(currtar) {
	if (currtar == null) {
		return false;
	}
	var highlightLTcolor = Orion.GetGlobal("targetHighlightColor");
	if (highlightLTcolor == null || highlightLTcolor == 0 || highlightLTcolor == "") {
		highlightLTcolor = 1152;
	}
	Orion.ClearHighlightCharacters(true);
	Orion.ClientLastTarget(currtar.Serial());
	Orion.CharPrint(Player.Serial(), "48", "Target:[" + currtar.Name() + "]");
	Orion.SetGlobal("LTHighlight", currtar.Serial());
	Orion.AddHighlightCharacter(currtar.Serial(), highlightLTcolor, true);
	var tempTarget = Orion.FindObject(Orion.GetGlobal("LeadHighlight"));
	var highlightCaller = Orion.GetGlobal("doCallerHighlight") == "true" ? true : false;
	var highlightCallerColor = Orion.GetGlobal("callerHighlightColor") == "" ? 1153 : Orion.GetGlobal("callerHighlightColor");
	if (highlightCaller && tempTarget) {
		Orion.AddHighlightCharacter(tempTarget.Serial(), highlightCallerColor, true);
	}
	CurrTarGump(currtar.Name(), currtar.Serial());
	Orion.SetGlobal("CTActionFlag", "true");
}

//@@Support function that takes a passed in object class, sets highlights them to the color that has been selected in the gump (or glacial as default) and sets the object as your Last Target.
//Support,Programming
function PvPSetTarget_Offscreen(currtar) {
	var highlightLTcolor = Orion.GetGlobal("targetHighlightColor");
	if (highlightLTcolor == null || highlightLTcolor == 0 || highlightLTcolor == "") {
		highlightLTcolor = 1152;
	}
	Orion.ClearHighlightCharacters(true);
	Orion.ClientLastTarget(currtar);
	Orion.SetGlobal("LTHighlight", currtar);
	Orion.AddHighlightCharacter(currtar, highlightLTcolor, true);
	var tempTarget = Orion.FindObject(Orion.GetGlobal("LeadHighlight"));
	var highlightCaller = Orion.GetGlobal("doCallerHighlight") == "true" ? true : false;
	var highlightCallerColor = Orion.GetGlobal("callerHighlightColor") == "" ? 1153 : Orion.GetGlobal("callerHighlightColor");
	if (highlightCaller && tempTarget) {
		Orion.AddHighlightCharacter(tempTarget.Serial(), highlightCallerColor, true);
	}
	CurrTarGump("Offscreen", currtar);
	Orion.SetGlobal("CTActionFlag", "true");
}

//@@Searches for the nearest OJ with 20 tiles and attacks them.
//PvP,Targetting
function AttackNearestOJ() {
	var mobArr = Orion.FindType("-1", "-1", ground, "live|ignoreself|ignorefriends|near", 20, "orange");

	if (mobArr.length) {
		var currtar = Orion.FindObject(mobArr[0]);
		Orion.CharPrint(Player.Serial(), "48", "Attacking:[" + currtar.Name() + "]");
		Orion.Attack(currtar.Serial());
	}
}

//@@Sets the closest non-human mobile as last target and attacks it.
//Targetting,PvM
function TargetNearestCreature() {
	var mobArr = Orion.FindTypeEx("-1", "-1", "ground", "live|nothuman", 15, "gray|criminal|enemy|red");
	attacktar = null;
	if (mobArr.length) {
		if (Array.isArray(mobArr)) {
			attacktar = mobArr[0];
			//Orion.Print(attacktar.Name() + " " + attacktar.Distance())
			for (var i = 0; i < mobArr.length; i++) {
				//Orion.Print(Orion.GetDistance(mobArr[i]));
				//if(Orion.FindObject(mobArr[i])){
				//pot = Orion.FindObject(mobArr[i]);
				//if(Orion.GetDistance(mobArr[i]) <= 1 && pot.Name() != ""){
				//  attacktar = mobArr[i];
				//break;
				//}

				if (mobArr[i].Distance() < attacktar.Distance()) {
					//Orion.Print(mobArr[i].Distance() + " " + attacktar.Distance())
					attacktar = mobArr[i];
				}
				//}
				Orion.Wait(10);
			}
		} else {
			attacktar = mobArr;
		}
		if (Orion.FindObject(attacktar.Serial())) {
			Orion.RemoveHighlightCharacter(Orion.GetGlobal("LTHighlight"), true);
			//Orion.ClientLastAttack(mobArr[lastInd]);
			Orion.ClientLastTarget(attacktar.Serial());
			Orion.Attack(attacktar.Serial());
			var currtar = attacktar;
			Orion.CharPrint(Player.Serial(), "48", "Target:[" + currtar.Name() + "]");
			Orion.SetGlobal("LTHighlight", attacktar.Serial());
			Orion.AddHighlightCharacter(attacktar.Serial(), "1152", true);
			//Orion.AddDisplayTimer(101,30000, 'Top', 'Rectangle|Bar', currtar.Name(), 0, 0, '0xFFFF', 4, 'green');
			//Orion.Ignore(mobArr[lastInd]);

			return attacktar;
		}
	} else {
		Orion.Print("No enemies.");
		return false;
	}
}

//@@Combines all Green humans and friends list and targets the lowest HP on screen.  If "swap back to LT" is selected, it will also swap back to the previous last target.
//PvP,Targetting,Healing
function FindHurtAlly() {
	var allycolor = Orion.GetGlobal("allyHighlightColor");
	var callercolor = Orion.GetGlobal("callerHighlightColor");
	var dolead = Orion.GetGlobal("doCallerHighlight") == "true" ? true : false;
	var highlightLTcolor = Orion.GetGlobal("targetHighlightColor");
	var doAllyLT = Orion.GetGlobal("doAllyLT") == "true" ? true : false;
	var stdDist = 10;
	var chivDist = 2;
	if (Orion.GetGlobal("spellRange") != null && Orion.GetGlobal("spellRange") != "") {
		var distCheck = parseInt(Orion.GetGlobal("spellRange"));
	} else {
		var distCheck = stdDist;
	}
	Orion.Ignore(self); //the find flag ignoreself doesn't work...
	fulllist = "";
	findfriend = Orion.GetFriendList();
	guildArr = Orion.FindType("-1", "-1", "ground", "live|ignorefriends|human", distCheck, "green");

	fulllist = guildArr.concat(findfriend);
	fulllist.push(Player.Serial());
	healtar = null;
	//Orion.Print(findfriend.length + " " + guildArr.length + " " + fulllist.length)
	for (var i = 0; i < fulllist.length; i++) {
		if (healtar == null && Orion.FindObject(fulllist[i])) {
			temptar = Orion.FindObject(fulllist[i]);
			healtar = temptar;
			//Orion.Print(temptar.Name())
		} else {
			if (Orion.FindObject(fulllist[i])) {
				temptar = Orion.FindObject(fulllist[i]);
				Orion.GetStatus(temptar.Serial());
				Orion.GetStatus(healtar.Serial());
				//Orion.Print(temptar.Name() && healtar.Name())
				if (temptar.Hits() < healtar.Hits()) {
					healtar = temptar;
				}
			}
		}
	}
	if (healtar && Orion.FindObject(healtar.Serial()) && Orion.FindObject(healtar.Serial()).Hits() < Orion.FindObject(healtar.Serial()).MaxHits()) {
		var oldtar = Orion.ClientLastTarget();
		Orion.ClientLastTarget(healtar.Serial());
		//Orion.TargetSystemSerial(healtar.Serial());
		Orion.CharPrint(self, 2128, "Healing: " + healtar.Name());
		Orion.RemoveHighlightCharacter(Orion.GetGlobal("LTHighlight"), true);
		if (dolead && Orion.GetGlobal("LeadHighlight") == Number(Orion.GetGlobal("LTHighlight"))) {
			Orion.AddHighlightCharacter(Orion.GetGlobal("LeadHighlight"), callercolor, true);
		}
		Orion.SetGlobal("LTHighlight", healtar.Serial());
		Orion.AddHighlightCharacter(healtar.Serial(), allycolor, true);
		//1161 = Blaze fire, 1153 = white,Glacial=1152
		if (Orion.GetDistance(healtar.Serial()) <= distCheck) {
			Orion.TargetObject(healtar.Serial());
		}
		if (doAllyLT) {
			Orion.ClientLastTarget(oldtar);
			//Orion.CharPrint(self,2128,"Target: " + healtar.Name());
			Orion.RemoveHighlightCharacter(Orion.GetGlobal("LTHighlight"), true);
			Orion.SetGlobal("LTHighlight", oldtar);
			Orion.AddHighlightCharacter(oldtar, highlightLTcolor, true);
		}
	} else {
		Orion.CharPrint(self, "2128", "No Injured Ally");
		//Orion.Print(healtar.Name());
	}
	Orion.SetGlobal("castChivheal", "false");
}
