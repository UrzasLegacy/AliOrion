		gumpObj[tempName].value = "N/A";
		gumpObj[tempName].color = color.black;
		gumpObj[tempName].parentPage = thePage;

		var tempName = "Character_Commit";
		gumpObj[tempName] = GumpObject("Guild Filter Refresh", currentSerial++, "button", 475, 300);
		gumpObj[tempName].graphic = "button_blue_blank";
		gumpObj[tempName].parentPage = thePage;
