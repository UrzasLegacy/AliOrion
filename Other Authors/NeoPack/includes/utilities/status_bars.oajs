		gumpObj[tempName].text = "N/A";
		gumpObj[tempName].color = color.white;
		gumpObj[tempName].parentPage = thePage;

		var tempName = "title_character_serial_title";
		gumpObj[tempName] = GumpObject("Function Tag Filter", currentSerial++, "text", 350, 80);
		gumpObj[tempName].xOffset = 20;
		gumpObj[tempName].text = "Character Serial:";
		gumpObj[tempName].color = color.yellowgold;
		gumpObj[tempName].parentPage = thePage;

		var tempName = "title_character_serial_value";
