	}
	Shared.AddArray("incharLib", gumpObj.characterLib.value);
	return [gumpObj, currentSerial];
}

function CharacterLibrary_UpdateGump(gumpObj) {
	var selectedOne = Orion.GetGlobal("characterLib_Selected") == "" ? false : Orion.GetGlobal("characterLib_Selected");
	var theFilter = gumpObj.GuildFilter_Dropdown.droplist[gumpObj.GuildFilter_Dropdown.value][0];
	Debug("[CharacterLibrary_UpdateGump][Info] Selected Character Library filter: " + theFilter + ", filtering " + gumpObj.characterLib.value.length + " guilds.");
	//Applying filter to function list
	for (var i = 0; i < gumpObj.characterLib.value.length; i++) {
		if (theFilter == "!All") {
			gumpObj[gumpObj.characterLib.value[i]].visible = true;
		} else {
			var theFunc = gumpObj[gumpObj.characterLib.value[i]].theFunc;
			//Debug("[CharacterLibrary_UpdateGump][Info] Evaluating: " + gumpObj.characterLib.value[i] + " which has tags: " + theFunc.guild);
			if (theFunc.guild == theFilter) {
				gumpObj[gumpObj.characterLib.value[i]].visible = true;
			} else {
				gumpObj[gumpObj.characterLib.value[i]].visible = false;
				Debug("[CharacterLibrary_UpdateGump][Info] Hiding: " + gumpObj.characterLib.value[i]);
			}
		}
	}
	//Adjusting the Y position of the remaining active functions
	var tempY = 5;
	for (var i = 0; i < gumpObj.characterLib.value.length; i++) {
		if (gumpObj[gumpObj.characterLib.value[i]].visible == true) {
			gumpObj[gumpObj.characterLib.value[i]].y = tempY;
			tempY += 30;
		}
	}
	//Updating the main window data
	Debug("[CharacterLibrary_Update][Info] Selected character: " + selectedOne);
	if (selectedOne == false) {
		gumpObj["title_character_title_value"].text = "N/A";
		gumpObj["title_character_serial_value"].text = "N/A";
		gumpObj["title_character_tags_value"].value = "N/A";
		gumpObj["title_character_alias_value"].value = "N/A";
	} else {
		Debug("[CharacterLibrary_Update][Info] Swapping Info to: " + selectedOne);
		if (selectedOne in gumpObj && "theFunc" in gumpObj[selectedOne]) {
			selectedOne = gumpObj[selectedOne].theFunc;
			gumpObj["title_character_title_value"].text = selectedOne.name;
			gumpObj["title_character_serial_value"].text = selectedOne.serial;
			gumpObj["title_character_tags_value"].value = selectedOne.guild;
			var tempAlias = selectedOne.alias == false ? "N/A" : selectedOne.alias;
			gumpObj["title_character_alias_value"].value = tempAlias;
		}
	}
	return gumpObj;
}

function CharacterLibrary_UpdateCharacter(gumpObj, action) {
	var selectedOne = Orion.GetGlobal("characterLib_Selected") == "" ? false : Orion.GetGlobal("characterLib_Selected");
	if (selectedOne == false) {
		Debug("[CharacterLibrary_UpdateCharacter][Error] No character is selected");
		return gumpObj;
	} else {
		var charPack = JSON_import("CharacterLibrary");
		if (charPack == false) {
			return gumpObj;
		}
		if (Orion.Contains(action, "Save")) {
			var tempSerial = gumpObj["title_character_serial_value"].text;
			var tempBool = tempSerial in charPack.characters;
			Debug("[CharacterLibrary_UpdateCharacter][Info] In Pack: " + tempBool + ", Window Serial: " + "characterLib_" + tempSerial + ", SelectedOne: " + selectedOne);
			if (tempSerial in charPack.characters && "characterLib_" + tempSerial == selectedOne) {
				charPack.characters[tempSerial].guild = gumpObj["title_character_tags_value"].value;
				//Check if there is a need to rebuild the alias arrays
				Debug("[CharacterLibrary_UpdateCharacter][Info] Comparison: " + gumpObj["title_character_alias_value"].value + " " + charPack.characters[tempSerial].alias);
				if (gumpObj["title_character_alias_value"].value != charPack.characters[tempSerial].alias) {
					Orion.SetGlobal("doCharRebuild", "true");
				}
				var tempAlias = gumpObj["title_character_alias_value"].value == "N/A" ? false : gumpObj["title_character_alias_value"].value;
				charPack.characters[tempSerial].alias = tempAlias;

				gumpObj["title_character_tags_value"].value = charPack.characters[tempSerial].guild;
				var tempAlias = charPack.characters[tempSerial].alias == false ? "N/A" : charPack.characters[tempSerial].alias;

				gumpObj["title_character_alias_value"].value = tempAlias;
				JSON_export("CharacterLibrary", charPack);
				Debug("[CharacterLibrary_UpdateCharacter][Info] Updating CharacterLibrary JSON.");
				//Now rebuilding the gumpObj bits that need to be updated.
				charPack.tagList = ["!All"];
				Object.keys(charPack.characters).forEach(function (key) {
					if (charPack.tagList.indexOf(charPack.characters[key].guild) == -1) {
						charPack.tagList.push(charPack.characters[key].guild);
					}
				});
				var tagFilterDrop = [];
				Object.keys(charPack.tagList).forEach(function (key) {
					tagFilterDrop.push([charPack.tagList[key], charPack.tagList[key]]);
				});
				tagFilterDrop.sort();
				var tempName = "GuildFilter_Dropdown";
				gumpObj[tempName].droplength = tagFilterDrop.length;
				gumpObj[tempName].droplist = tagFilterDrop;
				gumpObj[tempName].value = 0;
				var theFunc = charPack.characters[tempSerial];
				var tempName = "characterLib_" + tempSerial;
				var tempText = theFunc.alias == false ? theFunc.name : theFunc.name + " (" + theFunc.alias + ")";
				gumpObj[tempName].text = tempText;
				gumpObj[tempName].value = true;
				gumpObj[tempName].theFunc = theFunc;
			} else {
				Debug("[CharacterLibrary_UpdateCharacter][Error] Trying to update a character that doesn't exist (Or different name is selected): " + gumpObj["title_character_title_value"].text);
			}
		} else if (Orion.Contains(action, "Delete")) {
			if (selectedOne in gumpObj) {
				if (!(gumpObj[selectedOne].theFunc.serial in charPack.characters)) {
					Debug("[CharacterLibrary_UpdateCharacter][Error] Not finding character to delete in CharacterLibrary: " + gumpObj[selectedOne].theFunc.serial);
					return gumpObj;
				}
				Debug("[CharacterLibrary_UpdateCharacter][Info] Deleting character: " + selectedOne + " / " + gumpObj[selectedOne].theFunc.serial);
				delete charPack.characters[gumpObj[selectedOne].theFunc.serial];
				delete gumpObj[selectedOne];
				Orion.SetGlobal("doCharRebuild", "true");
				JSON_export("CharacterLibrary", charPack);
			} else {
				Debug("[CharacterLibrary_UpdateCharacter][Error] Not finding character to delete in gumpObj: " + selectedOne);
			}
		}
	}
	return gumpObj;
}

function CharacterLibrary_Add(serial, barObj) {
	if (serial == "") {
		Debug("[CharacterLibrary_Add][Error] Empty serial being passed in.");
		return false;
	} else {
		var charPack = JSON_import("CharacterLibrary");
		if (charPack == false) {
			Debug("[CharacterLibrary_Add][Error] Empty JSON being loaded.");
			return false;
		}
		if (serial in barObj.enemy.players && !(serial in charPack.characters)) {
			var player = barObj.enemy.players[serial];
			Debug("[CharacterLibrary_Add][Info] Adding character to Library: " + player.name);
			tempGuild = ReturnGuild(player.properties);
			if (tempGuild == false) return false;
			charPack.characters[serial] = CharacterLibraryObject(player.name, player.serial, tempGuild);
			JSON_export("CharacterLibrary", charPack);
			Debug("[CharacterLibrary_Add][Info] Adding character to Library: " + player.name);
			Orion.SetGlobal("doCharRebuild", "true");
		} else {
			Debug("[CharacterLibrary_Add][Error] Serial (" + serial + ") isn't in barobj or serial is already in the Character Library" + serial in charPack.characters);
		}
	}
}

function ReturnGuild(properties) {
	var tempGuild = /\[(.*?)\]/.exec(properties);
	if (tempGuild == null) return false;
	tempGuild = tempGuild.length > 1 ? tempGuild[1] : "None";
	tempGuild = tempGuild == "VvV" ? "None" : tempGuild;
	return tempGuild;
}

function CharacterLibrary_Rebuild(gumpObj) {
	Debug("[CharacterLibrary_Rebuild][Info] Rebuilding character library.");
	var libPack = JSON_import("CharacterLibrary");
	if (libPack == false) {
		return gumpObj;
	}
	libPack.tagList = ["!All"];
	Object.keys(libPack.characters).forEach(function (key) {
		if (libPack.tagList.indexOf(libPack.characters[key].guild) == -1) {
			libPack.tagList.push(libPack.characters[key].guild);
		}
	});
	var tagFilterDrop = [];
	Object.keys(libPack.tagList).forEach(function (key) {
		tagFilterDrop.push([libPack.tagList[key], libPack.tagList[key]]);
	});
	tagFilterDrop.sort();
	var tempName = "GuildFilter_Dropdown";
	gumpObj[tempName].droplength = tagFilterDrop.length;
	gumpObj[tempName].droplist = tagFilterDrop;
	gumpObj[tempName].value = 0;

	var tempX = 0;
	var tempY = 5;
	gumpObj.characterLib = {};
	gumpObj.characterLib.global = true;
	gumpObj.characterLib.value = [];
	var tempArray = [];
	Shared.RemoveArray("aliasArray_Serial");
	Shared.RemoveArray("aliasArray_Name");
	Object.keys(libPack.characters).forEach(function (key) {
		tempArray.push(key);
		if (libPack.characters[key].alias != "N/A" && libPack.characters[key].alias != false) {
			var aliasArray = Shared.GetArray("aliasArray_Serial", false);
			if (aliasArray == false) {
				Shared.AddArray("aliasArray_Serial", [libPack.characters[key].serial]);
				Shared.AddArray("aliasArray_Name", [libPack.characters[key].alias]);
			} else {
				var theIndex = aliasArray.indexOf(libPack.characters[key].serial);
				if (theIndex == -1) {
					aliasArray.push(libPack.characters[key].serial);
					var aliasArray_name = Shared.GetArray("aliasArray_Name");
					aliasArray_name.push(libPack.characters[key].alias);
					Shared.AddArray("aliasArray_Serial", aliasArray);
					Shared.AddArray("aliasArray_Name", aliasArray_name);
				} else {
					aliasArray_name[i] = libPack.characters[key].alias;
					Shared.AddArray("aliasArray_Name", aliasArray_name);
				}
			}
		}
	});
	tempArray.sort(function (a, b) {
		if ("characters" in libPack && a in libPack.characters) {
			var nameA = libPack.characters[a].name.toLowerCase(),
				nameB = libPack.characters[b].name.toLowerCase();
			if (nameA < nameB)
				//sort string ascending
				return -1;
			if (nameA > nameB) return 1;
			return 0; //default return value (no sorting)
		} else {
			Debug("[CharacterLibrary_Rebuild][Info] Something going wrong with the structure: " + a);
			return 0; //default return value (no sorting)
		}
	});
	var thePage = 16;
	for (var i = 0; i < tempArray.length; i++) {
		var theFunc = libPack.characters[tempArray[i]];
		var tempName = "characterLib_" + tempArray[i];
		gumpObj.characterLib.value.push(tempName);
		if (tempName in gumpObj) {
			Debug("[CharacterLibrary_Rebuild][Info] Object already exists in gumpObj, only updating: " + "characterLib_" + tempArray[i]);
			var tempText = theFunc.alias == false ? theFunc.name : theFunc.name + " (" + theFunc.alias + ")";
			gumpObj[tempName].text = tempText;
			gumpObj[tempName].value = false;
			gumpObj[tempName].theFunc = theFunc;
			gumpObj[tempName].x = tempX;
			gumpObj[tempName].y = tempY;
			tempY += 30;
		} else {
			Debug("[CharacterLibrary_Rebuild][Info] Adding new object to gumpObj: " + tempName);
			gumpObj[tempName] = GumpObject(theFunc.name, gumpObj.currentSerial.value++, "radio", tempX, tempY, false);
			gumpObj[tempName].graphic = "checkbox_gold_x";
			gumpObj[tempName].width = 125;
			gumpObj[tempName].xOffset = 0;
			var tempText = theFunc.alias == false ? theFunc.name : theFunc.name + " (" + theFunc.alias + ")";
			gumpObj[tempName].text = tempText;
			gumpObj[tempName].value = false;
			gumpObj[tempName].color = color.whiteText;
			gumpObj[tempName].parent = "CharacterList_Window";
			gumpObj[tempName].parentPage = thePage;
			gumpObj[tempName].theFunc = theFunc;
			gumpObj[tempName].dynamicAdd = false;
			tempY += 30;
		}
	}
	return gumpObj;
}

function DrawTest() {
	while (true) {
		var theObj = {};
		var friendCodeRef = [];
		theObj.hits = Player.Hits();
		theObj.maxhits = Player.MaxHits();
		theObj.poisoned = Player.Poisoned();
		theObj.serial = Player.Serial();
		theObj.name = Player.Name();
		theObj.position = 0;
		theObj.refKey = 0;
		friendCodeRef.push([0, Player.Serial(), "friend"]);

		DrawCharacterBar(theObj, { x: 500, y: 500 });
		theObj.serial = Player.Serial();
		theObj.position = 1;
		theObj.hits = Player.MaxHits() - Player.Hits();
		theObj.name = "Who Knows";
		theObj.refKey = 100;

		friendCodeRef.push([100, Player.Serial(), "friend"]);
		Shared.AddArray("friendCodeRef", friendCodeRef);

		DrawCharacterBar(theObj, { x: 500, y: 500 });

		Orion.Wait(600);
	}
}

function ClearBars() {
	Orion.SetGlobal("BarClear", "true");
}
function ToggleAutoBars() {
	if (Orion.GetGlobal("doPullbars") == "true") {
		Orion.SetGlobal("BarClear", "true");
		Orion.SetGlobal("killBars", "true");
		Orion.SetGlobal("doPullbars", "false");
	} else {
		Orion.SetGlobal("doPullbars", "true");
		Orion.RegWrite(Player.Serial() + "/Auto Bar Pulling", 1);
		Orion.Print("Starting Auto Bars.");
		Orion.Exec("AutoBarPopulate", true);
	}
}

function AutoBarPopulate() {
	//Handling if the script should be running or not
	var prefix = Player.Serial();
	if (Orion.RegRead(prefix + "/Auto Bar Pulling") == 0) {
		Orion.SetGlobal("BarClear", "true");
	} else {
		if (!Orion.ScriptRunning("AutoBarPopulate")) {
			Orion.Exec("AutoBarPopulate", true);
		}
	}
	//Setting global variables
	var players = [Player.Serial()];

	var offsetPlayersX = 30;
	var offsetPlayersY = 530;

	var pullbarsActive = Orion.GetGlobal("doPullbars") == "true" ? true : false;
	var doOld = Orion.GetGlobal("doUseOldBars") == "true" ? true : false;
	var ogFriendsX = Number(Orion.GetGlobal("pb_friend_x"));
	var ogFriendsY = Number(Orion.GetGlobal("pb_friend_y"));
	var offsetFriendsX = Number(Orion.GetGlobal("pb_friend_x"));
	var offsetFriendsY = Number(Orion.GetGlobal("pb_friend_y"));
	var numFriends = 0;

	var offsetEnemiesX = Number(Orion.GetGlobal("pb_enemy_x"));
	var offsetEnemiesY = Number(Orion.GetGlobal("pb_enemy_y"));
	var ogEnemiesX = Number(Orion.GetGlobal("pb_enemy_x"));
	var ogEnemiesY = Number(Orion.GetGlobal("pb_enemy_y"));
	var numEnemies = 0;
	var doSallos = Orion.GetGlobal("doSallosSpacing") == "true" ? true : false;
	var stepY = doSallos ? 40 : 60; //60 for standard bars, 40 for Sallos
	var stepX = doSallos ? 130 : 153; //153 for classic, 130 sallos
	var barsperrow = Number(Orion.GetGlobal("pb_barsper"));

	//Initializing variables
	var mobArr = [];
	var popArr = [];
	var guildArr = [];
	var guildpopArr = [];
	Orion.SetGlobal("BarClear", "false");
	Orion.SetGlobal("killBars", "false");

	while (doOld && pullbarsActive) {
		pullbarsActive = Orion.GetGlobal("doPullbars") == "true" ? true : false;
		Debug("[AutoBarPopulate][Trace] pullbarsActive after while call: " + pullbarsActive);
		mobArr = Orion.FindType("-1", "-1", ground, "live|ignoreself|ignorefriends|human", 25, "gray|orange");
		guildArr = Orion.FindType("-1", "-1", ground, "live|ignoreself|ignorefriends|human", 25, "green");
		fullArr = Orion.FindType("-1", "-1", ground, "live|ignoreself|human", 25);
		var friends = Orion.GetFriendList();
		var enemies = Orion.GetEnemyList();
		for (var i = 0; i < friends.length; i++) {
			if (fullArr.indexOf(friends[i]) != -1 && guildpopArr.indexOf(friends[i]) == -1 && Orion.FindObject(friends[i]) && Orion.FindObject(friends[i]).Name().length > 1) {
				//Orion.Print(offsetFriendsX + " | " + offsetFriendsY);
				Orion.ShowStatusbar(friends[i], offsetFriendsX, offsetFriendsY);
				guildpopArr.push(friends[i]);
				numFriends++;
				if (numFriends % barsperrow == 0) {
					offsetFriendsY = ogFriendsY;
					offsetFriendsX += -1 * stepX;
				} else {
					offsetFriendsY += stepY;
				}
			}
		}
		for (var i = 0; i < guildArr.length; i++) {
			if (guildpopArr.indexOf(guildArr[i]) == -1 && Orion.FindObject(guildArr[i]) && Orion.FindObject(guildArr[i]).Name().length > 1) {
				//Orion.Print(offsetFriendsX + " | " + offsetFriendsY);
				Orion.ShowStatusbar(guildArr[i], offsetFriendsX, offsetFriendsY);
				guildpopArr.push(guildArr[i]);
				numFriends++;
				if (numFriends % barsperrow == 0) {
					offsetFriendsY = ogFriendsY;
					offsetFriendsX += -1 * stepX;
				} else {
					offsetFriendsY += stepY;
				}
			}
		}
		for (var i = 0; i < mobArr.length; i++) {
			if (popArr.indexOf(mobArr[i]) == -1 && Orion.FindObject(mobArr[i]) && Orion.FindObject(mobArr[i]).Name().length > 1) {
				Orion.ShowStatusbar(mobArr[i], offsetEnemiesX, offsetEnemiesY);
				popArr.push(mobArr[i]);
				numEnemies++;
				if (numEnemies % barsperrow == 0) {
					offsetEnemiesY = ogEnemiesY;
					offsetEnemiesX += stepX;
				} else {
					offsetEnemiesY += stepY;
				}
			}
		}
		for (var i = 0; i < enemies.length; i++) {
			if (fullArr.indexOf(enemies[i]) != -1 && popArr.indexOf(enemies[i]) == -1 && Orion.FindObject(enemies[i]) && Orion.FindObject(enemies[i]).Name().length > 1) {
				Orion.ShowStatusbar(enemies[i], offsetEnemiesX, offsetEnemiesY);
				popArr.push(enemies[i]);
				numEnemies++;
				if (numEnemies % barsperrow == 0) {
					offsetEnemiesY = ogEnemiesY;
					offsetEnemiesX += stepX;
				} else {
					offsetEnemiesY += stepY;
				}
			}
		}
		if (Orion.GetGlobal("BarClear") == "true") {
			for (var i = 0; i < popArr.length; i++) {
				Orion.CloseStatusbar(popArr[i]);
			}
			popArr = [];
			for (var i = 0; i < guildpopArr.length; i++) {
				Orion.CloseStatusbar(guildpopArr[i]);
			}
			guildpopArr = [];
			Orion.SetGlobal("BarClear", "false");
			if (Orion.GetGlobal("killBars") == "true") {
				Orion.SetGlobal("doPullbars", 0);
				Orion.RegWrite(Player.Serial() + "/Auto Bar Pulling", 0);
				Orion.Print("Stopping Auto Bars.");
				Orion.SetGlobal("killBars", "false");
			}
			var offsetFriendsX = Number(Orion.GetGlobal("pb_friend_x"));
			var offsetFriendsY = Number(Orion.GetGlobal("pb_friend_y"));
			var offsetEnemiesX = Number(Orion.GetGlobal("pb_enemy_x"));
			var offsetEnemiesY = Number(Orion.GetGlobal("pb_enemy_y"));
		}
		Orion.Wait(1000);
	}
}
