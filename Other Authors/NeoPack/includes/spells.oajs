function CastChivHeal() {
	Orion.SetGlobal("spellRange", "2");
	Orion.Cast("Close Wounds");
}

function CastSpellRange(spell, range) {
	Orion.SetGlobal("spellRange", range);
	Orion.Cast(spell);
	Orion.WaitForTarget(3000);
	while (Orion.HaveTarget()) {
		Orion.Wait(100);
	}
	Orion.SetGlobal("spellRange", "10");
}

function WallTarget() {
	if (!Orion.HaveTarget()) {
		//Orion.Cast("Wall of Stone");
		CastSpellRange("Wall of Stone", 15);
	} else {
		var value = 3;
		var empty = 0;

		var offset = [
			[empty, -value], //direction = 0
			[value, -value], //direction = 1
			[value, empty], //direction = 2
			[value, value], //direction = 3
			[empty, value], //direction = 4
			[-value, value], //direction = 5
			[-value, empty], //direction = 6
			[-value, -value], //direction = 7
		];
		var currtar = Orion.FindObject(Orion.ClientLastTarget());
		if (currtar != null) {
			var xy = offset[currtar.Direction() & 7];
			xy[0] = xy[0] + currtar.X();
			xy[1] = xy[1] + currtar.Y();
			var tempTile = Orion.GetTiles("land", xy[0], xy[1]);
			if (tempTile.length > 0) {
				if (Orion.ValidateTargetTile("land", tempTile[0].X(), tempTile[0].Y())) {
					Orion.TargetTile("land", tempTile[0].X(), tempTile[0].Y(), tempTile[0].Z());
				} else {
					Orion.Print("Cannot target tile.");
				}
				//Orion.Print(tempTile[0].X() + " " + tempTile[0].Y()  + " " + tempTile[0].Z())
			} else {
				Orion.Print("Invalid tile.");
			}
		}
		//Orion.Cast('Wall of Stone');
	}
}

//--#Mystic Scripts

function CreateCleaseTrigger() {
	Orion.Cast("686");
	if (Orion.WaitForGump(8000)) {
		var gump0 = Orion.GetGump("last");
		if (gump0 !== null && !gump0.Replayed() && gump0.ID() === "0x00002336") {
			gump0.Select(Orion.CreateGumpHook(109));
			Orion.Wait(100);
		}
	}
}

function MaxMyst_CreateTrigger(dressMax, spell, dressNormal) {
	var mystTrigger = {};
	mystTrigger.Sleep = 104;
	mystTrigger["Nether Bolt"] = 100;
	mystTrigger["Purge Magic"] = 102;
	mystTrigger["Eagle Strike"] = 105;
	Orion.Dress(dressMax);
	Orion.Cast("Spell Trigger");
	while (GumpByID("0x00002336") == false) {
		Orion.Wait(100);
	}
	var gump0 = GumpByID("0x00002336");
	if (gump0 != null && gump0.ID() == "0x00002336") {
		gump0.Select(Orion.CreateGumpHook(104));
		Orion.Wait(100);
	}
	Orion.Dress(dressNormal);
}

function TriggerTarLT() {
	var triggerCD = 5;
	var stone = Orion.FindType("0x4079", "0xFFFF");
	if (stone.length == 0) {
		return false;
	}
	Orion.UseItemOnMobile(stone[0], lasttarget);
	Orion.Wait(500);
	var stone = Orion.FindType("0x4079", "0xFFFF");
	if (stone.length == 0 && Orion.GetGlobal("doTriggerTimer") == "true") {
		Orion.AddDisplayTimer("triggerTimer", triggerCD * 60000 - 500, "bottom", "Line|Bar", "", 200, -5, color.white, 3, color.redRGB);
		Orion.DisplayTimerSetIconType("triggerTimer", "gump");
		Orion.DisplayTimerSetShowTime("triggerTimer", false);
		Orion.DisplayTimerSetIcon("triggerTimer", "center", 0x5dc8, 0, 40, 12, 30, 30);
	}
}

