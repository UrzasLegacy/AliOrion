const Logger = {
    error: function (text) {
        Orion.Print(0x0021, JSON.stringify(text));
    },
    info: function (text) {
        Orion.Print(0x03E9, JSON.stringify(text));
    },
    warn: function (text) {
        Orion.Print(0x035, JSON.stringify(text));
    },
    debug: function (text) {
        TextWindow.Print(JSON.stringify(text));
        if (!TextWindow.IsOpened()) {
            TextWindow.Open();
        }
    },
};

const attemptList = {};

function autoLoot() {
    Orion.UseIgnoreList('IgnoredCorpses');
    setLootContainer();
    run();
}

function setLootContainer() {
	var lootContainer = Orion.FindObject('lootContainer');
	if (!lootContainer) {
		Orion.WaitForAddObject('target');
		Logger.info('Select container to store loot.');
		const target = Orion.FindObject('target');
		lootContainer = target ? target : Orion.FindObject(backpack);
	}
	
	Orion.SetGlobal('lootContainer', lootContainer.Serial());
}

function run() {
    try {
        const corpses = getAllCorpses();
        corpses.forEach(function (corpse) {
            if (lootCorpse(corpse) || Orion.InJournal('earn the right to loot')) {
                Orion.AddIgnoreListObject("IgnoredCorpses", corpse.Serial());
                Orion.ClearJournal();
    			Logger.info('All Looted!');
            }
        });
        Orion.Wait(250);
        run();
    } catch (error) {
        Logger.error(error);
    }
}

function getAllCorpses() {
    const corpseSerials = Orion.FindType('any', 0xFFFFF, 'any', 'ground', 2);
    const corpses = corpseSerials
        .map(function (serial) {
            return Orion.FindObject(serial);
        })
        .filter(function (object) {
            return object && object.Properties().toLowerCase().indexOf('corpse') > -1;
        });

    return corpses;
}

function lootCorpse(corpse) {
    const opened = Orion.OpenContainer(corpse.Serial(), '600', 'reach that|right to loot');
    if (!opened) {
        Logger.warn('Could not open corpse.');
        return opened;
    }
    Orion.Wait(250);
    const lootSerials = Orion.FindType('any', 'any', corpse.Serial(), ' ', 'finddistance', ' ', true);
    const corpseItems = lootSerials.map(function (serial) {
        return Orion.FindObject(serial);
    });
    const loot = getLootableItems(corpseItems);
    const allLooted = loot.every(lootItem);

    return allLooted;
}

function getLootableItems(corpseItems) {
	 const loot = corpseItems.reduce(function (acc, val) {
    	for (var i = 0; i < MasterLootList.length; i++) {
    		if (
    			(typeof MasterLootList[i] === 'number' && MasterLootList[i] === parseInt(val.Graphic())) ||
    			(typeof MasterLootList[i] === 'string' && val.Properties().toLowerCase().indexOf(MasterLootList[i]) > -1)
    		) {
    			acc.push(val);
    			break;
    		}
    	}
        
        return acc;
    }, []);

	return loot;
}

function lootItem(item) {
    const serial = item.Serial();
    const container = item.Container();
	const container = Orion.GetGlobal('lootContainer');
	Logger.info(container);

    Orion.Wait(750);
    Orion.MoveItem(item.Serial(), container);
    Orion.Wait(750);
    return !Orion.FindObject(serial, any, container);
}