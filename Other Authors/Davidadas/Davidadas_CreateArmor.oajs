// Main execution
function craftArmor() {
    setupContainers();
    cleanup();
    try {
        const allBods = getAllBods(craftList);
        allBods.forEach(function (bod, index) {
			returnResources();
    		fillBod(bod);
		    returnResources();
        });
    } catch (error) {
        Logger.error(error);
    } finally {
        Logger.info('Script Complete.');
        cleanup();
    }
}

function CraftingGump(type) {
    const config = MasterGumpList.crafting[type];
    const gumpIds = [
        0x000001CC,
    ];

    function _getGump() {
        for (var i = 0; i < Orion.GumpCount(); i++) {
            const gump = Orion.GetGump(i);
            const gumpId = parseInt(gump.ID());
            if (gumpIds.indexOf(gumpId) > -1) {
                return gump;
            }
        }
        return null;
    }

    function _clickOption(index, warning) {
        const gump = _getGump();
        if (!gump) {
            Logger.warn(warning);
            return false;
        }
        const hook = Orion.CreateGumpHook(index);
        if (!gump.Select(hook)) {
            Logger.error('Could not select hook: ' + index);
            return false;
        }
        Orion.WaitForGump(2000);
        return true;
    }

    function selectCategory(category) {
        const categoryID = config.categories[category];
        return _clickOption(categoryID, "Failed to open gump category " + category + ".");
    }

    function selectOption(option) {
        const result = _clickOption(option, "Failed to select gump option " + option + ".");
        Orion.Wait(2000);
        return result;
    }

    function selectResource(resource) {
        const resourceId = resource ? config.resources[resource] : 5000;
        return _clickOption(resourceId, "Failed to select resource " + resourceId + ".");
    }

    function selectMakeLast() {
        return _clickOption(config.makeLast, "Failed to 'Make Last'.");
    }

    function selectSmeltItem() {
        return _clickOption(config.smeltItem, "Failed to select 'Smelt item'.");
    }

    function close() {
        const gump = _getGump();
        if (!gump) {
            return false;
        }
        _getGump().Close();

        return true;
    }

    return {
        selectCategory: selectCategory,
        selectOption: selectOption,
        selectResource: selectResource,
        selectMakeLast: selectMakeLast,
        selectSmeltItem: selectSmeltItem,
        close: close,
    };
}

function getAllBods(list) {
   const keys = Object.keys(list);
    return keys.map(function (key) {
    	const craftable = list[key];
    	const name = key;
    	const amount = 1;
    	const itemToCraft = ItemManager.findItemByDisplayName(name);
        
        return {
        	reference: null,
        	material: null,
        	quality: 'Exceptional',
        	amount: amount,
        	target: name,
        	targetItem: itemToCraft,
        	remaining: amount,
        	resists: list[key],
        };
    });
}

function fillBod(bod) {
    if (!bod.remaining) {
        moveBodToStorage(bod);
    } else {
    	 const itemToCraft = ItemManager.findItemByDisplayName(bod.target);
    	 if (!itemToCraft) {
    	 	Logger.error('Unknown item ' + bod.target);
    	 	return;
    	 }
	    checkTools(bod);
	    var crafted = false;
	    while (!crafted) {
	        checkResources(itemToCraft, bod.remaining * 50, bod.material);
	        const craftedItem = craftItem(itemToCraft, 1, bod.material)[0];
	        const parsedItem = parseItem(craftedItem, itemToCraft);
	        if (!matchesRequirements(parsedItem, bod)) {
	            Orion.Wait(250);
	            destroyItem(parsedItem);
	        } else {
	        	crafted = true;
	        }
	    }
	    Orion.Wait(2500);
    }
}

function parseItem(item, template) {
    const properties = item.Properties();
    const quality = properties.indexOf('Exceptional') > -1 ? 'Exceptional' : 'Normal';

    return {
        reference: item,
        quality: quality,
        displayName: template.displayName,
        craftingType: template.craftingType,
    };
}

function getTargetCount(bod, item) {
    const serials = Orion.FindType(item.graphic);
    var count = Orion.Count(item.graphic);

    serials.forEach(function (serial) {
        const object = Orion.FindObject(serial);
        const matchesTarget = matchesRequirements(parseItem(object, item), bod);
        if (!matchesTarget) {
            count -= 1;
        }
    });
    return count;
}

function openContainer(object, recursive) {
    var parent = object.Container();
    const containers = [object];

    function findAndOpenParent(parent) {
        if (typeof parent === 'string') {
            parent = Orion.FindObject(parent);
        }
        if (parent) {
            containers.unshift(parent);
            findAndOpenParent(parent.Container());
        }
    }

    if (recursive) findAndOpenParent(parent);

    containers.forEach(function (container) {
        Orion.UseObject(container.Serial());
        Orion.Wait(1000);
    });
}

function setupContainers() {
    var resourceContainer = Orion.FindObject('resourceContainer');
    if (!resourceContainer) {
        const resourceContainer = targetContainer('Select a Resource Container.');
        Orion.SetGlobal('resourceContainer', resourceContainer.Serial());
    } else {
        Orion.SetGlobal('resourceContainer', resourceContainer.Serial());
    }

    if (!resourceContainer) {
        throw new Error('No \'resourceContainer\' set. Add in Objects -> Lists.');
    }

    openContainer(resourceContainer, true);
}

function targetContainer(text) {
    Logger.prompt(text);
    Orion.WaitForAddObject('target');
    var target = Orion.FindObject('target');

    return target;
}

function craftItem(item, numToBuild, resource, crafted) {
	Orion.CancelWaitGump();
    numToBuild = numToBuild || 1;
    const clonedArray = crafted ? [].concat(crafted) : [];
    
    if (numToBuild === clonedArray.length) return clonedArray;
    var lastCount = Orion.Count(item.graphic);
    // Double click crafting tool.
    const craftingTool = ToolMap[item.craftingType];

    Orion.UseType(craftingTool);
    Orion.WaitForGump(2000);
    
    // Select material, if applicable.
    const craftingGump = new CraftingGump(item.craftingType);
    craftingGump.selectResource(Utils.toCamelCase(resource));

    // Select category
    craftingGump.selectCategory(item.category);
    // Select the option to craft the item, then pause.
    craftingGump.selectOption(item.option);

    if (Orion.Count(item.graphic) > lastCount) {
        lastCount = Orion.Count(item.graphic);
        const craftedItemSerials = Orion.FindType(item.graphic);
        const craftedItem = Orion.FindObject(craftedItemSerials[craftedItemSerials.length - 1]);
        clonedArray.push(craftedItem);
    } else {
        Logger.warn('Did not make item.');
        checkResources(item, numToBuild, resource);
    }

    return craftItem(item, numToBuild - clonedArray.length, resource, clonedArray);
}

function checkTools(bod) {
    const tinkerTool = ItemManager.findItemByDisplayName('Tinker\'s Tools');
    const bodTarget = ItemManager.findItemByDisplayName(bod.target);
    const craftingTool = ItemManager.findItemByGraphic(ToolMap[bodTarget.craftingType]);
    const tinkerToolCount = Orion.Count(tinkerTool.graphic, any, self, 1, true);
    const craftingToolCount = Orion.Count(craftingTool.graphic, any, self, 1, true);

    [
        [craftingTool, craftingToolCount],
        [tinkerTool, tinkerToolCount],
    ]
        .forEach(function (toolInfo) {
            const tool = toolInfo[0];
            const toolCount = toolInfo[1];
            const numToBuild = 2 - toolCount;
            if (toolCount <= 1) {
                checkResources(tool, numToBuild, 0x0000);
                craftItem(tool, numToBuild);
    			returnResources();
            }
        });
}

function returnResources() {
    const resourceContainer = Orion.FindObject(Orion.GetGlobal('resourceContainer'));
    ['Ingots', 'Boards', 'Cloth', 'Blank Scroll', 'Shaft', 'Arrow', 'Crossbow Bolt', 'Leather'].forEach(function (resource) {
        const resourceItem = ItemManager.findItemByDisplayName(resource);
        const resourceSerials = Orion.FindType(resourceItem.graphic);
        // Convert each serial to an object then return it.
        resourceSerials.forEach(function (resourceSerial) {
            Orion.Wait(1000);
            const resourceObject = Orion.FindObject(resourceSerial);
            if (!resourceObject) return;
            Orion.MoveItem(resourceObject.Serial(), 0, resourceContainer.Serial());
            Orion.Wait(1000);
        });
    });
}

function checkResources(item, count, type) {
    const resourceContainer = Orion.FindObject(Orion.GetGlobal('resourceContainer'));
    const requiredMaterials = item.materials.map(function (materialInfo) {
        const graphic = materialInfo[0];
        const quantity = materialInfo[1];
        return {
            graphic: graphic,
            quantity: quantity * count,
        };
    });
    requiredMaterials.forEach(function (material, index) {
        const materialItem = ItemManager.findItemByGraphic(material.graphic);
        const quantity = material.quantity > 300 ? 300 : material.quantity;
        var materialColor = 0xFFFF; // This value is ignored.
        if (materialItem.types || type) {
            materialColor = type ? materialItem.types[Utils.toCamelCase(type)] : (Object.keys(materialItem.types)[0] || 0xFFFF);
        }
        const currentCount = Orion.Count(material.graphic);
        if (currentCount >= item.materials[index][1]) {
            return;
        }
        const currentSupply = Orion.Count(material.graphic, materialColor, resourceContainer.Serial());
        if (currentSupply < quantity) {
        	Logger.debug(currentSupply);
        	throw new Error('Insufficient Supply of ' + material.graphic);
        }
        const serial = Orion.FindType(material.graphic, materialColor, resourceContainer.Serial())[0];
        Orion.Wait(1000);
        Orion.MoveItem(serial, quantity);
        Orion.Wait(2000);
    });
}

function matchesRequirements(item, bod) {
	const parsedResists = parseResists(item.reference.Properties());
	const matchesResists = Object.keys(parsedResists).every(function(key) {
		return parsedResists[key] >= bod.resists[key];
	});
    const itemColor = parseInt(item.reference.Color());
    const bodColor = parseInt(MaterialColorMap[bod.material]);
    const itemGraphic = parseInt(item.reference.Graphic());
    const isQualityMatched = item.quality === 'Exceptional' || item.quality === bod.quality;

    return isQualityMatched && matchesResists;
}

function parseResists(input) {
    var resists = {};
    var resistPattern = /(Physical Resist|Fire Resist|Cold Resist|Poison Resist|Energy Resist) (\d+)%/g;
    var match;
    
    while (match = resistPattern.exec(input)) {
        var resistName = match[1];
        var resistValue = parseInt(match[2], 10);
        resists[resistName] = resistValue;
    }
    
    return resists;
}

function destroyItem(item) {
    const craftingType = item.craftingType;
    if (craftingType === 'blacksmithing') {
        const tongs = ItemManager.findItemByDisplayName('Tongs');
        Orion.UseType(tongs.graphic);
        if (!Orion.WaitForGump(2000)) {
            throw new Error('No gump opened.');
        }
        const craftingGump = new CraftingGump('blacksmithing');
        craftingGump.selectSmeltItem(item);
        if (Orion.WaitForTarget(3000)) {
            Orion.TargetObject(item.reference.Serial());
            if (item.reference.Exists()) {
	        	Logger.error('Item not smelted.');
	        }
        } else {
            Logger.error('Could not smelt item. Cursor not presented.');
        }

        Orion.Wait(2500);
    } else if (craftingType === 'tailoring') {
    	const scissors =  ItemManager.findItemByDisplayName('Scissors');
    	Orion.UseType(scissors.graphic);
    	if (Orion.WaitForTarget(3000)) {
            Orion.TargetObject(item.reference.Serial());
            if (item.reference.Exists()) {
	        	Logger.error('Item not smelted.');
	        }
        } else {
            Logger.error('Could cut up item. Cursor not presented.');
        }
    } else {
        const trashBarrelGraphic = ItemManager.findItemByDisplayName('A Trash Barrel').graphic;

        Orion.Wait(500);
        const trashBarrel = Orion.FindObject(Orion.FindType(trashBarrelGraphic, 0xFFFF, 'any')[0]);
        if (!trashBarrel) {
            Logger.warn('No nearby trash barrel to dispose of ' + item.Name());
        };
        Orion.MoveItem(item.reference.Serial(), 0, trashBarrel.Serial());
        if (item.reference.Container() !== trashBarrel.Serial()) {
        	Logger.error('Not trashed');
        }
    }
    Orion.Wait(500);
}

function cleanup() {
    Orion.CancelWaitGump();
    returnResources();
}

const containers = [
    [0x41D3E667],
    [0x42E52A2A],
    [0x42E57FE5],
    [0x42E5817A],
];

function openContainers() {
    containers.forEach(function (containerSerials) {
        containerSerials.forEach(function (serial) {
            Orion.UseObject(serial);
            Orion.Wait(1500);
        });
    });
}

const Logger = {
    error: function (text) {
        Orion.Print(0x0021, JSON.stringify(text));
    },
    info: function (text) {
        Orion.Print(0x03E9, JSON.stringify(text));
    },
    warn: function (text) {
        Orion.Print(0x035, JSON.stringify(text));
    },
    prompt: function (text) {
    	Orion.Print(0x5A, JSON.stringify(text));
    },
    debug: function (text) {
        TextWindow.Print(JSON.stringify(text));
        TextWindow.Open();
    },
};

const Utils = {
    toCamelCase: function (str) {
    	if (typeof str !== 'string') return;
        // converting all characters to lowercase
        var ans = str.toLowerCase();
        // Returning string to toCamelCase
        ans = ans.split(" ").reduce(function (s, c) {
            return s + (c.charAt(0).toUpperCase() + c.slice(1));
        }, '');
        ans = ans.charAt(0).toLowerCase() + ans.slice(1);
        return ans;
    }
}

const ItemManager = {
    findItemByDisplayName: function (displayName) {
        for (var i = 0; i < MasterItemList.length; i++) {
            if (displayName.toLowerCase() === MasterItemList[i].displayName.toLowerCase()) {
                return MasterItemList[i];
            }
        }
        return null;
    },
    findItemByGraphic: function (graphic) {
        for (var i = 0; i < MasterItemList.length; i++) {
            if (graphic === MasterItemList[i].graphic) {
                return MasterItemList[i];
            }
        }
        return null;
    },
    findMaterialNameByGraphic: function (graphic) {
    	const keys = Object.keys(MaterialColorMap);
    	for (var i = 0; i < keys; i++) {
    		if (MaterialColorMap[keys[i]] === parseInt(graphic)) {
    			return keys[i];
    		}
    	}
    	return null;
    }
}

